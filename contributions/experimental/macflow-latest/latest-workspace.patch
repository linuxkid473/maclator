+fn rule_action(args: &[String]) -> Result<Command, String> {
+    if args.len() != 3 {
+        return Err("rule requires a policy and exactly one application selector".into());
+    }
+    let selector = args[2].trim();
+    if selector.is_empty() || args[2].len() > 1024 || args[2].chars().any(char::is_control) {
+        return Err("invalid application selector".into());
+    }
+    match args[1].as_str() {
+        "default" => Ok(Command::RemoveRule {
+            selector: selector.into(),
+        }),
+        "protect" | "background" => Ok(Command::SetRule {
+            selector: selector.into(),
+            policy: if args[1] == "protect" {
+                RulePolicy::Protect
+            } else {
+                RulePolicy::AllowBackground
+            },
+        }),
+        _ => Err("rule must be protect, background or default".into()),
+    }
