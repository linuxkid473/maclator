#!/bin/zsh
# VS Code (darwin-arm64 zip unpacked in ~/vscode-arm64) under maclator with the Metal bridge.
cd "${VSCODE_DIR:-$HOME/vscode-arm64}" || exit 1
exec "$HOME/bin/maclator" --gpu --gpu-only --type=gpu-process "./Visual Studio Code.app/Contents/MacOS/Code" \
  --no-sandbox --disable-gpu-sandbox --disable-gpu-watchdog --use-angle=metal --use-gl=angle --enable-gpu \
  --ignore-gpu-blocklist --user-data-dir="${VSCODE_DATA:-$HOME/vscode-data}" --disable-workspace-trust "$@"
