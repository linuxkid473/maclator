+                Tone::Muted
+            } else {
+                Tone::Positive
+            })
+            .symbol("arrow.triangle.swap"),
+        ],
+    ));
+    model.sections.push(section(
+        "验证进度",
+        "实验能力需经过独立测试，资源占用不代表应用响应已经改善。",
+        verification_rows(status),
+    ));
+}
+
+fn selector(process: &ProcessSample) -> String {
+    process
+        .bundle_id
+        .clone()
+        .unwrap_or_else(|| process.identity.executable.clone())
+}
+
+fn basename(path: &str) -> &str {
+    path.rsplit('/').find(|p| !p.is_empty()).unwrap_or(path)
+}
+
+fn control_row(control: &ControlStatus, now_ms: u64) -> Row {
+    let (verification, tone) = match control.current_nice {
+        None => ("当前值尚未核验".into(), Tone::Warning),
+        Some(current) if current == control.applied_nice => {
+            (format!("当前 nice {current}，与写入值一致"), Tone::Positive)
+        }
+        Some(current) => (
+            format!("当前 nice {current}，与写入值不同；需核查恢复或外部修改"),
+            Tone::Warning,
+        ),
+    };
+    Row::new(
+        basename(&control.identity.executable),
+        format!("PID {} · 原因：{}", control.identity.pid, control.reason),
+        format!("nice {} → {}", control.original_nice, control.applied_nice),
+    )
+    .tone(tone)
+    .symbol("slider.horizontal.3")
+    .detail(format!(
+        "{verification} · {} · 施加于{}。响应改善尚无本项测量结果。",
+        control
+            .verified_at_ms
+            .map(|at| format!("核验于{}", relative_time(at, now_ms)))
+            .unwrap_or_else(|| "核验时间未知".into()),
+        relative_time(control.applied_at_ms, now_ms),
+    ))
+}
+
+fn applications(status: &Status, now_ms: u64, model: &mut PageModel) {
+    let mut controls = status.controls.iter().collect::<Vec<_>>();
+    controls.sort_by_key(|c| std::cmp::Reverse(c.applied_at_ms));
+    let rows = if controls.is_empty() {
+        vec![
+            Row::new("暂无优先级调整", "当前未报告 MacFlow 施加的控制", "未调节")
+                .tone(Tone::Muted)
+                .symbol("checkmark.circle"),
+        ]
+    } else {
+        controls
+            .into_iter()
+            .map(|c| control_row(c, now_ms))
+            .collect()
+    };
+    model.sections.push(section(
+        "实际控制",
+        "每项控制保留原值、写入值与当前核验，不把 nice 变化当作性能收益。",
+        rows,
+    ));
+
+    let mut processes = status.telemetry.processes.iter().collect::<Vec<_>>();
+    processes.sort_by(|a, b| {
+        let a_foreground = Some(a.identity.pid) == status.telemetry.foreground_pid;
+        let b_foreground = Some(b.identity.pid) == status.telemetry.foreground_pid;
+        b_foreground
+            .cmp(&a_foreground)
+            .then_with(|| {
+                finite_nonnegative(Some(b.cpu_percent))
+                    .unwrap_or(0.0)
+                    .total_cmp(&finite_nonnegative(Some(a.cpu_percent)).unwrap_or(0.0))
+            })
+            .then_with(|| a.name.cmp(&b.name))
+    });
+    let rows = if processes.is_empty() {
+        vec![
+            Row::new(
+                "等待进程采样",
+                "服务连接后将列出运行中的应用与任务",
+                "暂无数据",
+            )
+            .tone(Tone::Muted)
+            .symbol("app"),
+        ]
+    } else {
+        processes
+            .into_iter()
+            .map(|process| {
+                let disabled = status.config.disabled_rules.iter().any(|rule| {
+                    rule == &process.identity.executable || process.bundle_id.as_ref() == Some(rule)
+                });
+                let (role, tone) = match process.role {
+                    TaskRole::Foreground => ("前台保护", Tone::Positive),
+                    TaskRole::Protected => ("保护", Tone::Positive),
+                    TaskRole::Compute if disabled => ("已隔离", Tone::Warning),
+                    TaskRole::Compute if status.helper_connected => ("可调节", Tone::Neutral),
+                    TaskRole::Compute => ("仅监测", Tone::Warning),
+                    TaskRole::Unknown => ("仅监测", Tone::Muted),
+                };
+                let mut detail = format!("nice {} · {}", process.nice, selector(process));
+                if let Some(reason) = &process.protected_reason {
+                    detail.push_str(&format!(" · 保护原因：{reason}"));
+                } else if process.role == TaskRole::Unknown {
+                    detail.push_str(" · 用途或交互依赖不明确，保持原状态");
+                } else if disabled {
+                    detail.push_str(" · 匹配的管理规则已隔离，不继续施加控制");
+                } else if status.config.observe_only && process.role == TaskRole::Compute {
+                    detail.push_str(" · 观察模式，暂不施加新控制");
+                }
+                Row::new(
+                    &process.name,
+                    format!(
+                        "PID {} · CPU {}（单核） · 内存 {}",
+                        process.identity.pid,
+                        percentage(Some(process.cpu_percent)),
+                        bytes(Some(process.memory_bytes))
+                    ),
+                    role,
+                )
+                .tone(tone)
+                .symbol(if process.role == TaskRole::Foreground {
+                    "macwindow"
+                } else {
+                    "app"
+                })
+                .detail(detail)
+            })
+            .collect()
+    };
+    model.sections.push(section(
+        "运行中的应用与任务",
+        "前台应用优先显示；CPU 为单核百分比，可超过 100%。",
+        rows,
+    ));
+
+    let mut rules = status.config.rules.iter().collect::<Vec<_>>();
+    rules.sort_by(|a, b| a.selector.cmp(&b.selector));
+    let rows = if rules.is_empty() {
+        vec![
+            Row::new(
+                "尚未添加应用规则",
+                "选择应用后永久保护，或明确允许其后台计算任务被管理",
+                "按默认策略",
+            )
+            .tone(Tone::Muted)
+            .symbol("list.bullet"),
+        ]
+    } else {
+        rules
+            .into_iter()
+            .map(|rule| {
+                let disabled = status.config.disabled_rules.contains(&rule.selector);
+                Row::new(
+                    basename(&rule.selector),
+                    &rule.selector,
+                    if disabled {
+                        "已隔离"
+                    } else if rule.policy == RulePolicy::Protect {
+                        "永久保护"
+                    } else {
+                        "允许后台管理"
+                    },
+                )
+                .tone(if disabled {
+                    Tone::Warning
+                } else if rule.policy == RulePolicy::Protect {
+                    Tone::Positive
+                } else {
+                    Tone::Neutral
+                })
+                .symbol(if disabled {
+                    "exclamationmark.shield"
+                } else {
+                    "shield"
+                })
+                .detail(if disabled {
+                    "该规则暂不施加控制；请在诊断中核查退步或错误证据。"
+                } else if rule.policy == RulePolicy::Protect {
+                    "始终保留原优先级；前台与依赖保护仍由服务验证。"
+                } else {
+                    "只在确认为后台计算且出现争用时调整；前台切换立即撤销限制。"
+                })
+            })
+            .collect()
+    };
+    model.sections.push(section(
+        "应用规则",
+        "规则精确匹配 bundle ID 或完整可执行文件路径。",
+        rows,
+    ));
+}
+
+fn feedback_row(result: &PerformanceFeedbackStatus, now_ms: u64) -> Row {
+    let metric = match result.metric {
+        PerformanceMetric::InteractionP95 => "交互 p95 延迟",
+        PerformanceMetric::BackgroundDuration => "后台任务耗时",
+        PerformanceMetric::UncontendedDuration => "无争用耗时",
+    };
+    let change = if result.median_regression_percent.is_finite() {
+        format!("{:+.1}%", result.median_regression_percent)
+    } else {
+        "未知".into()
+    };
+    let threshold = percentage(Some(result.threshold_percent));
+    Row::new(
+        &result.scenario,
+        format!(
+            "{metric} · {} 对开关配对 · {}",
+            result.total_pairs,
+            relative_time(result.at_ms, now_ms)
+        ),
+        change,
+    )
+    .tone(if result.disabled {
+        Tone::Warning
+    } else if result.median_regression_percent.is_finite() && result.median_regression_percent < 0.0
+    {
+        Tone::Positive
+    } else {
+        Tone::Neutral
+    })
+    .symbol("chart.bar.xaxis")
+    .detail(format!(
+        "耗时中位数变化，正值为退步 · 退步配对 {}/{} · 阈值 {} · {}。证据：{} · 规则：{}",
+        result.worse_pairs,
+        result.total_pairs,
+        threshold,
+        if result.disabled {
+            "规则已隔离"
+        } else {
+            "未触发自动隔离"
+        },
+        result.evidence_id,
+        result.selector
+    ))
+}
