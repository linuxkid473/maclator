+    #[test]
+    fn compatibility_gate_precedes_configuration_lock_and_keeps_latest_mode() {
+        let mut s = benchmark_state(Telemetry::default());
+        s.status.config.observe_only = false;
+        let state = Arc::new(Mutex::new(s));
+        let (worker, notify, requests) = test_compatibility_worker();
+        let mut monitor = CompatibilityMonitor::new(Some(test_signature("A")), 100);
+        monitor.accept_probe(test_probe("A", 0, 100));
+        let mutation = CONFIGURATION_MUTATION.lock().unwrap();
+        publish_compatibility(
+            &worker.updates,
+            &notify,
+            Some(test_probe("B", 1, 200)),
+            None,
+        );
+        poll_compatibility(&state, &worker, &mut monitor, 200);
+        let (gated, config_observed) = {
+            let mut s = state.lock().unwrap();
+            s.status.config.mode = Mode::Performance;
+            (s.observation_required(), s.status.config.observe_only)
+        };
+        drop(mutation);
+        assert!(gated);
+        assert!(
+            !config_observed,
+            "test holds mutation lock; only the independent gate can change"
+        );
+        let started = std::time::Instant::now();
+        let request = loop {
+            poll_compatibility(&state, &worker, &mut monitor, 250);
+            if let Ok(request) = requests.try_recv() {
+                break request;
+            }
+            assert!(started.elapsed() < Duration::from_secs(1));
+            // Other tests may hold the global mutation lock. Real control
+            // ticks likewise retry without waiting on that lock.
+            std::thread::yield_now();
+        };
+        assert_eq!(request.generation, monitor.generation);
+        let s = state.lock().unwrap();
+        assert_eq!(s.status.config.mode, Mode::Performance);
+        assert!(s.status.config.observe_only);
+        assert_eq!(s.events.len(), 1);
+    }
