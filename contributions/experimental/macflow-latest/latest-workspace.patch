+fn publish_compatibility(
+    updates: &Mutex<CompatibilityUpdates>,
+    notifications: &std::sync::mpsc::SyncSender<()>,
+    probe: Option<CompatibilityProbe>,
+    persisted: Option<(u64, Result<(), String>)>,
+) {
+    let mut latest = updates.lock().unwrap_or_else(|_| std::process::exit(70));
+    if let Some(probe) = probe {
+        latest.probe = Some(probe);
+    }
+    if let Some(persisted) = persisted {
+        latest.persisted = Some(persisted);
+    }
+    drop(latest);
+    // The channel is a capacity-one notification. A full channel retains the
+    // newest bounded mailbox contents instead of discarding a version change.
+    let _ = notifications.try_send(());
