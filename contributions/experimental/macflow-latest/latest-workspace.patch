+//! MacFlow's icon is drawn in Rust with native, CPU-backed AppKit paths.
+//! The bundle generator uses the same artwork as the live application image.
+
+use objc2::AnyThread;
+use objc2::rc::Retained;
+use objc2_app_kit::{
+    NSBezierPath, NSBitmapImageFileType, NSBitmapImageRep, NSColor, NSCompositingOperation,
+    NSDeviceRGBColorSpace, NSGradient, NSGraphicsContext, NSImage, NSLineCapStyle, NSLineJoinStyle,
+};
+use objc2_foundation::{MainThreadMarker, NSDictionary, NSPoint, NSRect, NSSize, NSString};
+use std::path::Path;
+
+/// Restore the caller's current graphics context even if native drawing fails
+/// through a caught Rust panic in the caller. No context is shared with workers.
+struct GraphicsState;
+impl Drop for GraphicsState {
+    fn drop(&mut self) {
+        NSGraphicsContext::restoreGraphicsState_class();
+    }
+}
+
+fn bounds(x: f64, y: f64, width: f64, height: f64, scale: f64) -> NSRect {
+    NSRect::new(
+        NSPoint::new(x * scale, y * scale),
+        NSSize::new(width * scale, height * scale),
+    )
+}
+
+/// Native image for `NSApplication::setApplicationIconImage` and sidebar use.
+/// A 512px representation keeps the permanent image allocation to about 1 MiB.
+pub fn image(mtm: MainThreadMarker) -> Retained<NSImage> {
+    let image = NSImage::initWithSize(NSImage::alloc(), NSSize::new(512.0, 512.0));
+    if let Ok(bitmap) = render(mtm, 512) {
+        image.addRepresentation(&bitmap);
+    }
+    image
+}
+
+/// Write a transparent 1024×1024 PNG for iconutil. No window or run loop starts.
+pub fn write_png(mtm: MainThreadMarker, path: &Path) -> Result<(), String> {
+    let path = path.to_str().ok_or("Icon path must be valid Unicode")?;
+    let bitmap = render(mtm, 1024)?;
+    // An empty immutable dictionary contains no untyped PNG property values.
+    let png = unsafe {
+        bitmap.representationUsingType_properties(NSBitmapImageFileType::PNG, &NSDictionary::new())
+    }
+    .ok_or("AppKit could not encode the application icon")?;
+    if !png.writeToFile_atomically(&NSString::from_str(path), true) {
+        return Err(format!("Could not write application icon to {path}"));
+    }
+    Ok(())
+}
+
+fn render(_mtm: MainThreadMarker, pixels: isize) -> Result<Retained<NSBitmapImageRep>, String> {
+    // Null planes instruct AppKit to allocate and own the RGBA storage. Row and
+    // pixel widths of zero use AppKit's validated layout for these four samples.
+    let bitmap = unsafe {
+        NSBitmapImageRep::initWithBitmapDataPlanes_pixelsWide_pixelsHigh_bitsPerSample_samplesPerPixel_hasAlpha_isPlanar_colorSpaceName_bytesPerRow_bitsPerPixel(
+            NSBitmapImageRep::alloc(),
+            std::ptr::null_mut(),
+            pixels,
+            pixels,
+            8,
+            4,
+            true,
+            false,
+            NSDeviceRGBColorSpace,
+            0,
+            0,
+        )
+    }
+    .ok_or("AppKit could not allocate application icon pixels")?;
+    bitmap.setSize(NSSize::new(pixels as f64, pixels as f64));
+    let context = NSGraphicsContext::graphicsContextWithBitmapImageRep(&bitmap)
+        .ok_or("AppKit could not create an icon drawing context")?;
+    NSGraphicsContext::saveGraphicsState_class();
+    let _restore = GraphicsState;
+    NSGraphicsContext::setCurrentContext(Some(&context));
+    context.setShouldAntialias(true);
+    context.setCompositingOperation(NSCompositingOperation::Clear);
+    NSBezierPath::fillRect(bounds(0.0, 0.0, 1024.0, 1024.0, pixels as f64 / 1024.0));
+    context.setCompositingOperation(NSCompositingOperation::SourceOver);
+    draw(pixels as f64 / 1024.0);
+    Ok(bitmap)
+}
+
+fn draw(scale: f64) {
+    let tile = NSBezierPath::bezierPathWithRoundedRect_xRadius_yRadius(
+        bounds(84.0, 84.0, 856.0, 856.0, scale),
+        192.0 * scale,
+        192.0 * scale,
+    );
+    let upper = NSColor::colorWithSRGBRed_green_blue_alpha(0.24, 0.61, 1.0, 1.0);
+    let lower = NSColor::colorWithSRGBRed_green_blue_alpha(0.075, 0.31, 0.85, 1.0);
+    if let Some(gradient) =
+        NSGradient::initWithStartingColor_endingColor(NSGradient::alloc(), &lower, &upper)
+    {
+        gradient.drawInBezierPath_angle(&tile, 90.0);
+    } else {
+        upper.setFill();
+        tile.fill();
+    }
+
+    // A restrained inner edge keeps the shape crisp against both appearances.
+    NSColor::colorWithSRGBRed_green_blue_alpha(1.0, 1.0, 1.0, 0.15).setStroke();
+    tile.setLineWidth(2.0 * scale);
+    tile.stroke();
+
+    // The pulse represents steady flow and responsiveness, without lettering
+    // that becomes unreadable at Dock and Spotlight sizes.
+    let pulse = NSBezierPath::bezierPath();
+    for (index, (x, y)) in [
+        (260.0, 510.0),
+        (355.0, 510.0),
+        (416.0, 652.0),
+        (477.0, 381.0),
+        (543.0, 573.0),
+        (591.0, 510.0),
+        (764.0, 510.0),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let point = NSPoint::new(x * scale, y * scale);
+        if index == 0 {
+            pulse.moveToPoint(point);
+        } else {
+            pulse.lineToPoint(point);
+        }
+    }
+    pulse.setLineCapStyle(NSLineCapStyle::Round);
+    pulse.setLineJoinStyle(NSLineJoinStyle::Round);
+    pulse.setLineWidth(48.0 * scale);
+    NSColor::colorWithSRGBRed_green_blue_alpha(1.0, 1.0, 1.0, 0.97).setStroke();
+    pulse.stroke();
+}
