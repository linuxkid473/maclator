+
+    #[test]
+    fn normalization_preserves_latest_duplicate_and_only_requested_range() {
+        let points = normalize_points(
+            vec![
+                point(9, Some(1.0)),
+                point(20, Some(2.0)),
+                point(19, Some(3.0)),
+                point(20, None),
+                point(21, Some(4.0)),
