+//! Owned presentation data for the native AppKit interface.
+//!
+//! The model never calls platform APIs, reads a file, or changes policy. Values
+//! are labels for existing observations; a missing or invalid metric stays
+//! unknown. All AppKit objects belong to the renderer on the main thread.
+#![forbid(unsafe_code)]
+
+use macflow_protocol::{
+    Capability, ControlStatus, MemoryPressure, Mode, PerformanceFeedbackStatus, PerformanceMetric,
+    ProcessSample, RulePolicy, Status, TaskRole,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Page {
+    Overview,
+    Applications,
+    Performance,
+    Diagnostics,
+    Settings,
+}
+
+impl Page {
+    pub const ALL: [Self; 5] = [
+        Self::Overview,
+        Self::Applications,
+        Self::Performance,
+        Self::Diagnostics,
+        Self::Settings,
+    ];
+
+    pub fn title(self) -> &'static str {
+        match self {
+            Self::Overview => "总览",
+            Self::Applications => "应用",
+            Self::Performance => "性能",
+            Self::Diagnostics => "诊断",
+            Self::Settings => "设置",
+        }
+    }
+
+    pub fn symbol(self) -> &'static str {
+        match self {
+            Self::Overview => "square.grid.2x2",
+            Self::Applications => "app.badge",
+            Self::Performance => "chart.xyaxis.line",
+            Self::Diagnostics => "stethoscope",
+            Self::Settings => "slider.horizontal.3",
+        }
+    }
+
+    pub fn index(self) -> usize {
+        match self {
+            Self::Overview => 0,
+            Self::Applications => 1,
+            Self::Performance => 2,
+            Self::Diagnostics => 3,
+            Self::Settings => 4,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Tone {
+    Neutral,
+    Positive,
+    Warning,
+    Critical,
+    Muted,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Metric {
+    pub title: String,
+    pub value: String,
+    pub subtitle: String,
+    pub tone: Tone,
+    /// A known ratio suitable for a progress indicator, bounded to [0, 1].
+    /// Never synthesize a zero when the underlying observation is missing.
+    pub fraction: Option<f64>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Row {
+    pub title: String,
+    pub subtitle: String,
+    pub value: String,
+    pub detail: Option<String>,
+    pub tone: Tone,
+    pub symbol: &'static str,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Section {
+    pub title: String,
+    pub subtitle: Option<String>,
+    pub rows: Vec<Row>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct PageModel {
+    pub page: Page,
+    pub title: String,
+    pub subtitle: String,
+    pub metrics: Vec<Metric>,
+    pub sections: Vec<Section>,
+}
+
+impl Row {
+    fn new(
+        title: impl Into<String>,
+        subtitle: impl Into<String>,
+        value: impl Into<String>,
+    ) -> Self {
+        Self {
+            title: title.into(),
+            subtitle: subtitle.into(),
+            value: value.into(),
+            detail: None,
+            tone: Tone::Neutral,
+            symbol: "circle",
+        }
+    }
+
+    fn tone(mut self, tone: Tone) -> Self {
+        self.tone = tone;
