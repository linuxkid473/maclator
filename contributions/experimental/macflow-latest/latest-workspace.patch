+
+impl CompatibilityMonitor {
+    fn new(signature: Option<serde_json::Value>, started_ms: u64) -> Self {
+        Self {
+            initial_signature: signature,
+            last_signature: None,
+            last_revision: None,
+            started_ms,
+            last_completed_ms: None,
+            generation: 0,
+            required: true,
+            unavailable: false,
+            persistence_error_reported: false,
+            committed: false,
+            pending: None,
+            in_flight: None,
+            retry_after_ms: 0,
+        }
+    }
+
+    fn observe(&mut self, signature: Option<serde_json::Value>) {
+        self.generation = self.generation.saturating_add(1);
+        self.required = true;
+        self.committed = false;
+        self.persistence_error_reported = false;
+        self.pending = Some(CompatibilityPersistence {
+            generation: self.generation,
+            signature,
+        });
+        self.in_flight = None;
+        self.retry_after_ms = 0;
+    }
+
+    fn unavailable(&mut self, reason: &str) -> Option<String> {
+        if self.unavailable {
+            return None;
+        }
+        self.unavailable = true;
+        self.last_signature = None;
+        self.observe(None);
+        Some(format!(
+            "Compatibility watcher unavailable; observation required: {reason}"
+        ))
+    }
+
+    fn accept_probe(&mut self, probe: CompatibilityProbe) -> Option<String> {
+        self.last_completed_ms = Some(probe.at_ms);
+        match probe.signature {
+            Err(error) => self.unavailable(&error),
+            Ok(signature) => {
+                let was_unavailable = self.unavailable;
+                self.unavailable = false;
+                let first_matches = self.last_revision.is_none()
+                    && probe.revision == 0
+                    && self.initial_signature.as_ref() == Some(&signature)
+                    && !was_unavailable;
+                let changed = self.last_revision != Some(probe.revision)
+                    || self.last_signature.as_ref() != Some(&signature);
+                self.last_revision = Some(probe.revision);
+                self.last_signature = Some(signature.clone());
+                if first_matches {
+                    // Preserve the saved user mode when the first verified
+                    // fingerprint matches; no observation event or disk write.
+                    self.required = false;
+                    return None;
+                }
+                if changed || was_unavailable {
+                    self.observe(Some(signature));
+                    return Some("System, driver, Maclator or MacFlow identity changed; observation required".into());
+                }
+                None
+            }
+        }
+    }
