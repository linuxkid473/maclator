+
+fn bounded_command_output(
+    command: &mut std::process::Command,
+    stderr: bool,
+) -> Result<CompatibilityCommandOutput, String> {
+    use std::io::Read;
+    use std::process::Stdio;
+    command.stdin(Stdio::null());
+    command.stdout(if stderr {
+        Stdio::null()
+    } else {
+        Stdio::piped()
+    });
+    command.stderr(if stderr {
+        Stdio::piped()
+    } else {
+        Stdio::null()
+    });
+    let mut child = command.spawn().map_err(|e| e.to_string())?;
+    let started = std::time::Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) if started.elapsed() < Duration::from_secs(3) => {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            other => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(match other {
+                    Err(error) => error.to_string(),
+                    _ => "compatibility command exceeded three-second budget".into(),
+                });
+            }
+        }
+    };
+    let mut bytes = Vec::new();
+    if stderr {
+        child
+            .stderr
+            .take()
+            .ok_or("missing command stderr")?
+            .take(16 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|e| e.to_string())?;
+    } else {
+        child
+            .stdout
+            .take()
+            .ok_or("missing command stdout")?
+            .take(16 * 1024 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|e| e.to_string())?;
+    }
+    if bytes.len() > 16 * 1024 {
+        return Err("oversized compatibility command output".into());
+    }
+    Ok(CompatibilityCommandOutput {
+        success: status.success(),
+        bytes,
+    })
+}
