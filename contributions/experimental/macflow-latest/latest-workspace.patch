+struct CompatibilityMonitor {
+    initial_signature: Option<serde_json::Value>,
+    last_signature: Option<serde_json::Value>,
+    last_revision: Option<u64>,
+    started_ms: u64,
+    last_completed_ms: Option<u64>,
+    generation: u64,
+    required: bool,
+    unavailable: bool,
+    persistence_error_reported: bool,
