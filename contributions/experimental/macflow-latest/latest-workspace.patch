+        raise ValueError("Rust application icon must be a 1024×1024 PNG")
+    iconset = temporary / "MacFlow.iconset"
+    iconset.mkdir()
+    for points in (16, 32, 128, 256, 512):
+        for scale in (1, 2):
+            pixels = points * scale
+            suffix = "@2x" if scale == 2 else ""
+            target = iconset / f"icon_{points}x{points}{suffix}.png"
+            if pixels == 1024:
+                shutil.copyfile(source, target)
+            else:
+                run("/usr/bin/sips", "--resampleHeightWidth", str(pixels), str(pixels),
+                    str(source), "--out", str(target))
+    icon = resources / "icon.icns"
+    run("/usr/bin/iconutil", "--convert", "icns", "--output", str(icon), str(iconset))
