+fn optional_code_requirement(path: &std::path::Path) -> Result<Option<String>, String> {
+    let output = bounded_command_output(
+        std::process::Command::new("/usr/bin/codesign")
+            .args(["--display", "--verbose=4"])
+            .arg(path),
+        true,
+    )?;
+    if !output.success {
+        return Ok(None);
+    }
+    let output = String::from_utf8(output.bytes).map_err(|_| "invalid codesign output")?;
+    let hash = output
+        .lines()
+        .find_map(|line| line.strip_prefix("CDHash="))
+        .filter(|hash| hash.len() == 40 && hash.bytes().all(|b| b.is_ascii_hexdigit()))
+        .ok_or("code-directory hash unavailable")?;
+    Ok(Some(format!("cdhash H\"{hash}\"")))
+}
