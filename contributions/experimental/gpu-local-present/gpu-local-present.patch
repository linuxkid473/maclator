+        pthread_mutex_unlock(&gLocalPresentLock);
+        [NSException raise:@"MCLLocalPresentInvalidState" format:@"Local command commit rejected (pending=%d guest_main=%d); concurrent/repeated/cross-thread local commits are unsupported", pending, mainThread];
+    }
+    state[@"phase"] = @"preparing";
