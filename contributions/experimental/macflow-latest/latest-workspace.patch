+    fn capture(&self, dir: &std::path::Path, name: &str) -> Result<(), String> {
+        std::fs::create_dir_all(dir).map_err(|e| e.to_string())?;
+        let root = self.ivars().root.get().unwrap();
+        let bounds = root.bounds();
+        let rep = root
+            .bitmapImageRepForCachingDisplayInRect(bounds)
+            .ok_or("native snapshot unavailable")?;
+        root.effectiveAppearance()
+            .performAsCurrentDrawingAppearance(&block2::StackBlock::new(|| {
+                root.cacheDisplayInRect_toBitmapImageRep(bounds, &rep);
+            }));
+        let data = unsafe {
+            rep.representationUsingType_properties(NSBitmapImageFileType::PNG, &NSDictionary::new())
+        }
+        .ok_or("PNG encoding unavailable")?;
+        let path = dir.join(format!("{name}.png"));
+        if !data.writeToFile_atomically(&NSString::from_str(&path.to_string_lossy()), true) {
+            return Err("snapshot write failed".into());
+        }
+        crate::storage::atomic_json(
+            &dir.join(format!("{name}.json")),
+            &serde_json::json!({"page":Page::ALL[self.ivars().page.get()].title(),"native_content_size":{"width":bounds.size.width,"height":bounds.size.height},"source":"native AppKit view caching; real current service snapshot","status_received":self.ivars().status.borrow().is_some(),"stale_qa_state":self.ivars().stale.get(),"visible_entries":self.ivars().entries.borrow().len(),"history_range":self.ivars().history_range.get(),"history_points_loaded":self.ivars().history.borrow().points.len(),"history_truncated":self.ivars().history.borrow().truncated,"table_columns":self.ivars().table.get().unwrap().tableColumns().iter().map(|col|(col.identifier().to_string(),col.width())).collect::<Vec<_>>()}),
+        )?;
+        Ok(())
