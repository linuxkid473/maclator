+// General memory-library contract probe. Compile unchanged for x86-64 and ARM.
+// Volatile function pointers plus -fno-builtin preserve real library calls.
+#include <errno.h>
+#include <spawn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+static void *(*volatile copy_call)(void *, const void *, size_t) = memcpy;
+static void *(*volatile move_call)(void *, const void *, size_t) = memmove;
+static void *(*volatile fill_call)(void *, int, size_t) = memset;
+static void (*volatile zero_call)(void *, size_t) = bzero;
+static uint64_t checksum = 0x137;
+
+static void require(int condition, const char *what) {
+    if (!condition) { fprintf(stderr, "FAIL: %s\n", what); exit(1); }
+}
+static void seed(unsigned char *p, size_t n) {
+    for (size_t i = 0; i < n; i++) p[i] = (unsigned char)(i * 31 + 17);
+}
+static void digest(const unsigned char *p, size_t n) {
+    for (size_t i = 0; i < n; i++) checksum = (checksum ^ p[i]) * 0x100000001b3ULL;
+}
+static void same(const unsigned char *a, const unsigned char *b, size_t n, const char *what) {
+    for (size_t i = 0; i < n; i++) require(a[i] == b[i], what);
+}
+static void *tag(void *pointer, unsigned top) {
+#if defined(__aarch64__)
+    return (void *)((uintptr_t)pointer | ((uintptr_t)top << 56));
+#else
+    (void)top;
+    return pointer;
+#endif
+}
+
+static void ordinary_contracts(void) {
+    const size_t capacity = 65536;
+    unsigned char *source = malloc(capacity), *destination = malloc(capacity);
+    require(source && destination, "allocation");
+    const size_t sizes[] = {0, 1, 7, 15, 16, 31, 64, 255, 4095, 4096, 4097, 8191, 16384};
+    const size_t offsets[] = {0, 1, 7, 15, 31, 63};
+    for (size_t s = 0; s < sizeof(sizes) / sizeof(*sizes); s++) {
+        size_t n = sizes[s];
+        for (size_t o = 0; o < sizeof(offsets) / sizeof(*offsets); o++) {
+            size_t offset = offsets[o];
+            seed(source, capacity); seed(destination, capacity);
+            void *d = tag(destination + offset, 0xab);
+            const void *p = tag(source + 127 - offset, 0xcd);
+            errno = EDOM;
+            require(copy_call(d, p, n) == d, "memcpy original tagged return");
+            require(errno == EDOM, "memcpy guest errno");
+            same(destination + offset, source + 127 - offset, n, "memcpy bytes");
+            require(destination[offset + n] == (unsigned char)((offset + n) * 31 + 17), "memcpy upper canary");
+            if (offset) require(destination[offset - 1] == (unsigned char)((offset - 1) * 31 + 17), "memcpy lower canary");
+            digest(destination, n + offset + 1);
+            errno = ERANGE;
+            require(fill_call(d, 0x139, n) == d, "memset original tagged return");
+            require(errno == ERANGE, "memset guest errno");
+            for (size_t i = 0; i < n; i++) require(destination[offset + i] == 0x39, "memset low byte");
+            digest(destination, n + offset + 1);
+            errno = E2BIG;
+            zero_call(d, n);
+            require(errno == E2BIG, "bzero guest errno");
+            for (size_t i = 0; i < n; i++) require(destination[offset + i] == 0, "bzero bytes");
+            digest(destination, n + offset + 1);
+        }
+    }
+    free(source); free(destination);
+    puts("PASS: copy/fill/zero sizes, alignments, tagged returns, canaries and errno");
+}
+
+static void overlap_contracts(void) {
+    const size_t capacity = 32768;
+    unsigned char *actual = malloc(capacity), *expected = malloc(capacity);
+    require(actual && expected, "overlap allocation");
+    const size_t sizes[] = {0, 15, 4095, 4096, 8192};
+    const int deltas[] = {-63, -1, 1, 63};
+    for (size_t s = 0; s < sizeof(sizes) / sizeof(*sizes); s++) {
+        for (size_t d = 0; d < sizeof(deltas) / sizeof(*deltas); d++) {
+            size_t n = sizes[s], from = 4096, to = (size_t)((int)from + deltas[d]);
+            seed(actual, capacity); seed(expected, capacity);
+            if (to < from) { for (size_t i = 0; i < n; i++) expected[to + i] = expected[from + i]; }
+            else { for (size_t i = n; i > 0; i--) expected[to + i - 1] = expected[from + i - 1]; }
+            void *destination = tag(actual + to, 0xab);
+            errno = EDOM;
+            // Preserve the common baseline comparison with matching tags.
+            // Different-tag overlap is an enabled-only compatibility probe.
+            require(move_call(destination, tag(actual + from, 0xab), n) == destination, "memmove tagged return");
+            require(errno == EDOM, "memmove guest errno");
+            for (size_t i = 0; i < capacity; i++) {
+                if (actual[i] != expected[i]) {
+                    fprintf(stderr, "overlap n=%zu delta=%d byte=%zu actual=%u expected=%u\n",
+                        n, deltas[d], i, actual[i], expected[i]);
+                    require(0, "overlapping memmove full buffer");
+                }
+            }
+            digest(actual, capacity);
+        }
+    }
+    free(actual); free(expected);
+    puts("PASS: overlapping memmove in both directions and TBI aliases");
+}
+
+static void guard_contracts(void) {
+    size_t page = (size_t)getpagesize();
+    unsigned char *s = mmap(NULL, 3 * page, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    unsigned char *d = mmap(NULL, 3 * page, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    require(s != MAP_FAILED && d != MAP_FAILED && page >= 4096, "guard allocation");
+    require(mprotect(s + page, page, PROT_READ | PROT_WRITE) == 0, "guard source writable");
+    require(mprotect(d + page, page, PROT_READ | PROT_WRITE) == 0, "guard destination writable");
+    seed(s + page, page);
+    require(mprotect(s + page, page, PROT_READ) == 0, "read-only source");
+    const size_t sizes[] = {1, 31, 4095, 4096};
+    for (size_t i = 0; i < sizeof(sizes) / sizeof(*sizes); i++) {
+        size_t n = sizes[i];
+        void *destination = d + 2 * page - n;
+        const void *source = s + 2 * page - n;
+        errno = ERANGE;
+        require(copy_call(destination, source, n) == destination, "guard copy return");
+        require(errno == ERANGE, "guard copy errno");
+        same(destination, source, n, "read-only source at unmapped guard boundary");
+        // Page sizes differ by architecture; hash a common end-relative pattern.
+        digest(destination, n);
+    }
+    require(munmap(s, 3 * page) == 0 && munmap(d, 3 * page) == 0, "guard unmap");
+    puts("PASS: read-only source and unmapped guard boundaries");
+}
+
+#if defined(__aarch64__)
+static uint64_t private_status(uint64_t operation, uintptr_t dst, uintptr_t second, uint64_t length) {
+    register uint64_t x0 __asm__("x0") = dst;
+    register uint64_t x1 __asm__("x1") = second;
+    register uint64_t x2 __asm__("x2") = length;
+    register uint64_t x16 __asm__("x16") = 0x4d4d;
+    register uint64_t x17 __asm__("x17") = operation;
+    uint64_t before, after;
+    __asm__ volatile("mrs %4,nzcv\n svc #0x80\n mrs %5,nzcv"
+        : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x17), "=&r"(before), "=&r"(after)
+        : "r"(x16) : "memory", "cc");
+    require(x0 == dst && x1 == second && x2 == length, "private ABI original arguments/result");
+    require(before == after, "private ABI NZCV");
+    return x17;
+}
+
+static void private_contracts(int expected_active) {
+    unsigned char *buffer = malloc(8192);
+    require(buffer != NULL, "private allocation");
+    const uintptr_t commpage = 0x0000000fffff4000ULL;
+    require(private_status(1, UINTPTR_MAX, UINTPTR_MAX, 0) == (expected_active ? 0 : 1), "zero size does not dereference");
+    require(private_status(1, (uintptr_t)buffer, 1, UINT64_MAX) == 1, "size overflow declines");
+    require(private_status(1, (uintptr_t)buffer, commpage - 8, 4096) == 1, "crossing commpage start declines");
+    require(private_status(1, (uintptr_t)buffer, 0x0000001000000000ULL - 8, 4096) == 1, "crossing commpage end declines");
+    require(private_status(1, commpage, (uintptr_t)buffer, 4096) == 1, "all commpage destinations decline");
+    require(private_status(2, commpage, 0, 4096) == 1, "commPage fill declines");
+    require(private_status(1, (uintptr_t)buffer, (uintptr_t)buffer, 4095) == 1, "small direct call declines");
+    require(private_status(2, (uintptr_t)tag(buffer, 0xab), 0xcd, 4095) == 1, "small fill declines");
+    require(private_status(3, (uintptr_t)tag(buffer, 0xab), 4095, 0) == 1, "small zero declines");
+    require(private_status(1, (uintptr_t)tag((void *)commpage, 0xab), (uintptr_t)tag(buffer, 0xcd), 1) == 1,
+        "small mixed-tag commpage destination declines");
+    require(private_status(1, (uintptr_t)tag(buffer, 0xab), (uintptr_t)tag((void *)(commpage - 1), 0xcd), 2) == 1,
+        "small mixed-tag crossing commpage start declines");
+    require(private_status(1, (uintptr_t)tag(buffer, 0xab), (uintptr_t)tag((void *)(0x0000001000000000ULL - 1), 0xcd), 2) == 1,
+        "small mixed-tag crossing commpage end declines");
+    require(private_status(999, (uintptr_t)buffer, (uintptr_t)buffer, 4096) == 1, "unknown operation declines");
+    require(private_status(1, (uintptr_t)buffer, (uintptr_t)buffer, 4096) == (expected_active ? 0 : 1), "active versus disabled dispatch");
+    if (expected_active) {
+        // Tests actual interposed memmove, not just the private SVC. The
+        // original guest libc's mixed-tag failure is preserved separately.
+        const size_t capacity = 12288;
+        unsigned char *actual = malloc(capacity), *expected = malloc(capacity);
+        require(actual && expected, "mixed-tag overlap allocation");
+        const size_t sizes[] = {1, 7, 15, 16, 31, 64, 255, 4095, 4096};
+        const int deltas[] = {-63, -1, 0, 1, 63};
+        for (size_t s = 0; s < sizeof(sizes) / sizeof(*sizes); s++) {
+            for (size_t d = 0; d < sizeof(deltas) / sizeof(*deltas); d++) {
+                size_t n = sizes[s], from = 4096, to = (size_t)((int)from + deltas[d]);
+                seed(actual, capacity); seed(expected, capacity);
+                if (to < from) { for (size_t i = 0; i < n; i++) expected[to + i] = expected[from + i]; }
+                else { for (size_t i = n; i > 0; i--) expected[to + i - 1] = expected[from + i - 1]; }
+                void *destination = tag(actual + to, 0xab);
+                errno = EDOM;
+                require(move_call(destination, tag(actual + from, 0xcd), n) == destination,
+                    "mixed-tag memmove original tagged return");
+                require(errno == EDOM, "mixed-tag memmove guest errno");
+                for (size_t i = 0; i < capacity; i++) {
+                    if (actual[i] != expected[i]) {
+                        fprintf(stderr, "mixed-tag overlap n=%zu delta=%d byte=%zu actual=%u expected=%u\n",
+                            n, deltas[d], i, actual[i], expected[i]);
+                        require(0, "mixed-tag memmove full buffer and canaries");
+                    }
+                }
+            }
+        }
+        free(actual); free(expected);
+        puts("PASS: mixed-tag real memmove sizes 1..4096, +/- overlap and normalized aliases");
+    }
+    errno = EDOM;
+    require(copy_call(buffer, tag((void *)(commpage + 0x100), 0xaa), 4096) == buffer, "contained commpage source return");
+    require(errno == EDOM, "commpage copy errno");
+    for (size_t i = 0; i < 4096; i++) {
+        require(buffer[i] == *(volatile unsigned char *)(commpage + 0x100 + i), "commpage source mapping");
+    }
+    free(buffer);
+    puts("PASS: private ABI, zero, overflow, disabled fallback and complete commpage mapping");
+}
+#endif
+
+static void spawn_contracts(const char *self, int expected_active) {
+    pid_t child;
+    char *native_args[] = {"/usr/bin/true", NULL};
+    require(posix_spawn(&child, native_args[0], NULL, NULL, native_args, environ) == 0, "native spawn");
+    int status;
+    require(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0, "native child shim scrub");
+    char *guest_args[] = {(char *)self, "--child", expected_active ? "--expect-bridge" : "--expect-disabled", NULL};
+    require(posix_spawn(&child, self, NULL, NULL, guest_args, environ) == 0, "same-architecture spawn");
+    require(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0, "translated child shim/options");
+    puts("PASS: native child scrub and translated child opt-in propagation");
+}
+
+int main(int argc, char **argv) {
+    int child = 0, expected_active = 0;
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "--child")) child = 1;
+        if (!strcmp(argv[i], "--expect-bridge")) expected_active = 1;
+    }
+    ordinary_contracts(); overlap_contracts(); guard_contracts();
+#if defined(__aarch64__)
+    private_contracts(expected_active);
+#endif
+    printf("CHECKSUM=%llu\n", (unsigned long long)checksum);
+    fflush(stdout);
+    if (!child) spawn_contracts(argv[0], expected_active);
+    return 0;
+}
