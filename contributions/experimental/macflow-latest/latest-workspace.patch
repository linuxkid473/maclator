+    fn accept_persistence(
+        &mut self,
+        generation: u64,
+        result: Result<(), String>,
+        now_ms: u64,
+    ) -> Option<String> {
+        if generation != self.generation {
+            return None;
+        }
+        let request = self.in_flight.take();
+        match result {
+            Ok(()) => {
+                if !self.unavailable && self.last_signature.is_some() {
+                    self.required = false;
+                }
+                self.pending = None;
+                None
+            }
+            Err(error) => {
+                self.required = true;
+                self.pending = request;
+                self.retry_after_ms = now_ms.saturating_add(2000);
+                if self.persistence_error_reported {
+                    None
+                } else {
+                    self.persistence_error_reported = true;
+                    Some(format!(
+                        "Compatibility persistence failed; observation retained: {error}"
+                    ))
+                }
+            }
+        }
