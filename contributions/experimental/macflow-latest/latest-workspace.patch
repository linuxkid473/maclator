+fn percentage(value: Option<f64>) -> String {
+    value
+        .filter(|v| v.is_finite() && *v >= 0.)
+        .map(|v| format!("{v:.1}%"))
+        .unwrap_or_else(|| "未知".into())
+}
+
+fn installed_preview_status() -> Result<Status, String> {
+    let output = std::process::Command::new("/Applications/MacFlow.app/Contents/MacOS/macflow")
+        .args(["status", "--json"])
+        .output()
+        .map_err(|e| e.to_string())?;
+    if !output.status.success() {
+        return Err(String::from_utf8_lossy(&output.stderr).trim().into());
+    }
+    if output.stdout.len() > macflow_protocol::MAX_PAYLOAD {
+        return Err("Preview status exceeded capacity".into());
+    }
+    serde_json::from_slice(&output.stdout).map_err(|e| e.to_string())
+}
+
+fn epoch_seconds() -> u64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+}
+
+fn matching_selectors(
+    rules: &[macflow_protocol::AppRule],
+    process: &macflow_protocol::ProcessSample,
+) -> Vec<String> {
+    rules
+        .iter()
+        .filter(|r| macflow_core::selector_matches_process(&r.selector, process))
+        .map(|r| r.selector.clone())
+        .collect()
+}
+
+fn display_protection_reason(reason: &str) -> &str {
+    match reason {
+        "root process" => "管理员进程始终受保护。",
+        "system service" => "系统关键服务始终受保护。",
+        "desktop, media or management dependency" => "桌面、音视频或管理服务的依赖，始终受保护。",
+        "foreground application" => "当前前台应用，优先保护交互响应。",
+        _ => reason,
+    }
+}
