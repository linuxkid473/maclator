+//! Opt-in native memory primitives, reached through an ARM interposing shim.
+//!
+//! This is a library-call bridge, not a BSD syscall: libc memory operations
+//! have no errno result. Preserve all guest state except the documented x0
+//! result and x17 completion status. Checked address arithmetic and commpage
+//! translation do not prove VM accessibility. Like the original C operation,
+//! callers must provide live readable/writable objects for the whole range.
+//! Synchronous host faults are not yet converted to recoverable guest faults.
+
+use maclator_core::{cpu::Cpu, mem};
+use std::path::PathBuf;
+use std::sync::{atomic::{AtomicU64, Ordering}, OnceLock};
+
+pub const SYS_MCL_MEMCALL: u64 = 0x4d4d;
+pub const OP_COPY: u64 = 1;
+pub const OP_FILL: u64 = 2;
+pub const OP_ZERO: u64 = 3;
+pub const MIN_SIZE: u64 = 4096;
+const SHIM_NAME: &str = "libmclplatform.dylib";
+const TBI_MASK: u64 = 0x00ff_ffff_ffff_ffff;
+// Darwin x86-64 user mappings occupy the positive canonical half.
+const HOST_END: u64 = 1 << 47;
+
+static COPY_CALLS: AtomicU64 = AtomicU64::new(0);
+static FILL_CALLS: AtomicU64 = AtomicU64::new(0);
+static BYTES: AtomicU64 = AtomicU64::new(0);
+static DECLINED: AtomicU64 = AtomicU64::new(0);
+
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("MACLATOR_NATIVE_PLATFORM").as_deref() == Ok("1"))
+}
+
+pub fn shim_path() -> Option<String> {
+    let path = if let Some(path) = std::env::var_os("MACLATOR_PLATFORM_SHIM") {
+        PathBuf::from(path)
+    } else {
+        std::env::current_exe().ok()?.parent()?.join(SHIM_NAME)
+    };
+    let path = std::fs::canonicalize(path).ok()?;
+    path.is_file().then(|| path.to_string_lossy().into_owned())
+}
+
+/// Return the injected path so the same opt-in and path can be forwarded to
+/// ARM children. Native children must have this ARM dylib scrubbed from envp.
+pub fn inject(envp: &mut Vec<String>) -> Result<String, String> {
+    let shim = shim_path().ok_or_else(|| format!("{SHIM_NAME} not found; set MACLATOR_PLATFORM_SHIM"))?;
+    let image = crate::macho::MachO::open_arm64(&shim, false)
+        .map_err(|e| format!("invalid ARM shim {shim}: {e}"))?;
+    if image.filetype != 6 { return Err(format!("platform shim is not MH_DYLIB: {shim}")); }
+    if let Some(entry) = envp.iter_mut().find(|e| e.starts_with("DYLD_INSERT_LIBRARIES=")) {
+        let value = entry.strip_prefix("DYLD_INSERT_LIBRARIES=").unwrap();
+        if !value.split(':').any(|path| path == shim) {
+            if !value.is_empty() { entry.push(':'); }
+            entry.push_str(&shim);
+        }
+    } else {
+        envp.push(format!("DYLD_INSERT_LIBRARIES={shim}"));
+    }
+    Ok(shim)
+}
+
+/// Map one entire nonempty interval, never only its first byte. Crossing a
+/// commpage boundary is declined because the range is not one linear mapping.
+/// All commpage destinations are declined, including in-place mappings.
+fn map_range(address: u64, length: u64, writing: bool, redirect: u64) -> Option<u64> {
+    if length == 0 || length > isize::MAX as u64 || usize::try_from(length).is_err() { return None; }
+    let start = address & TBI_MASK;
+    let end = start.checked_add(length)?;
+    if start == 0 || end > HOST_END { return None; }
+    let overlaps_commpage = start < mem::COMMPAGE_SPAN_END && end > mem::COMMPAGE_SPAN_START;
+    let mapped = if overlaps_commpage {
+        if writing || start < mem::COMMPAGE_SPAN_START || end > mem::COMMPAGE_SPAN_END { return None; }
+        if redirect == 0 { start }
+        else { redirect.checked_add(start - mem::COMMPAGE_SPAN_START)? }
+    } else { start };
+    if mapped == 0 || mapped.checked_add(length)? > HOST_END { return None; }
+    Some(mapped)
+}
+
+fn call(cpu: &mut Cpu, active: bool) -> bool {
+    let op = cpu.x[17];
+    if !active || !matches!(op, OP_COPY | OP_FILL | OP_ZERO) { return false; }
+    let destination = cpu.x[0];
+    let length = if op == OP_ZERO { cpu.x[1] } else { cpu.x[2] };
+    // Zero-sized calls must not examine or dereference either pointer. The
+    // original tagged destination is the result, even if it is null/invalid.
+    if length == 0 { return true; }
+    // A small copy with different TBI tags also needs normalized-pointer
+    // direction selection. Other small calls retain the original guest path.
+    if length < MIN_SIZE && !(op == OP_COPY && ((destination ^ cpu.x[1]) >> 56) != 0) {
+        return false;
+    }
+    let redirect = mem::COMMPAGE_REDIRECT.load(Ordering::Relaxed);
+    let Some(destination_host) = map_range(destination, length, true, redirect) else { return false };
+    let source_host = if op == OP_COPY {
+        let Some(source) = map_range(cpu.x[1], length, false, redirect) else { return false };
+        source
+    } else { 0 };
+    unsafe {
+        // The guest's __error/TSD storage is separate. Preserve host errno as
+        // well, so runtime machinery does not leak a host-library side effect.
+        let errno_pointer = libc::__error();
+        let saved_errno = *errno_pointer;
+        if op == OP_COPY {
+            // memcpy and memmove may resolve to one dyld address. One shared
+            // replacement uses memmove for both; this also handles TBI aliases.
+            libc::memmove(destination_host as *mut libc::c_void,
+                source_host as *const libc::c_void, length as usize);
+            COPY_CALLS.fetch_add(1, Ordering::Relaxed);
+        } else {
+            let value = if op == OP_ZERO { 0 } else { (cpu.x[1] & 255) as i32 };
+            libc::memset(destination_host as *mut libc::c_void, value, length as usize);
+            FILL_CALLS.fetch_add(1, Ordering::Relaxed);
+        }
+        *errno_pointer = saved_errno;
+    }
+    BYTES.fetch_add(length, Ordering::Relaxed);
+    // x0 stays the original guest spelling, including its top-byte tag. Do
+    // not set carry, clear flags, mutate x1/x2, or touch the guest TLS/errno.
+    cpu.x[0] = destination;
+    true
+}
+
+pub fn hostcall(cpu: &mut Cpu) {
+    let completed = call(cpu, enabled());
+    if !completed { DECLINED.fetch_add(1, Ordering::Relaxed); }
+    cpu.x[17] = if completed { 0 } else { 1 };
+}
+
+pub fn report() {
+    if enabled() && std::env::var_os("MACLATOR_STATS").is_some() {
+        eprintln!("[maclator] native platform: copy={} fill={} bytes={} declined={}",
+            COPY_CALLS.load(Ordering::Relaxed), FILL_CALLS.load(Ordering::Relaxed),
+            BYTES.load(Ordering::Relaxed), DECLINED.load(Ordering::Relaxed));
+    }
+}
+
