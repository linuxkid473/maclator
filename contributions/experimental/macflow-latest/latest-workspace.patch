+}
+
+pub fn mode_name(mode: Mode) -> &'static str {
+    match mode {
+        Mode::Auto => "自动",
+        Mode::Smooth => "流畅优先",
+        Mode::Performance => "性能优先",
+    }
+}
+
+fn memory_state(value: MemoryPressure) -> (&'static str, Tone) {
+    match value {
+        MemoryPressure::Unknown => ("未知", Tone::Muted),
+        MemoryPressure::Normal => ("正常", Tone::Positive),
+        MemoryPressure::Warning => ("警告", Tone::Warning),
+        MemoryPressure::Critical => ("严重", Tone::Critical),
+    }
+}
+
+fn finite_nonnegative(value: Option<f64>) -> Option<f64> {
+    value.filter(|v| v.is_finite() && *v >= 0.0)
+}
+
+fn percentage(value: Option<f64>) -> String {
+    finite_nonnegative(value)
+        .map(|v| format!("{v:.1}%"))
+        .unwrap_or_else(|| "未知".into())
+}
+
+fn bytes(value: Option<u64>) -> String {
+    match value {
+        None => "未知".into(),
+        Some(v) if v >= 1_000_000_000 => format!("{:.2} GB", v as f64 / 1_000_000_000.0),
+        Some(v) if v >= 1_000_000 => format!("{:.1} MB", v as f64 / 1_000_000.0),
+        Some(v) if v >= 1_000 => format!("{:.1} KB", v as f64 / 1_000.0),
+        Some(v) => format!("{v} B"),
+    }
+}
+
+fn count(value: Option<u64>) -> String {
+    value
+        .map(|v| v.to_string())
+        .unwrap_or_else(|| "未知".into())
+}
+
+fn relative_time(at_ms: u64, now_ms: u64) -> String {
+    if at_ms == 0 || at_ms > now_ms {
+        return "时间未知".into();
+    }
+    let age = (now_ms - at_ms) / 1000;
+    match age {
+        0 => "刚刚".into(),
+        1..=59 => format!("{age} 秒前"),
+        60..=3599 => format!("{} 分钟前", age / 60),
+        3600..=86399 => format!("{} 小时前", age / 3600),
+        _ => format!("{} 天前", age / 86400),
+    }
+}
+
+fn sample_fresh(status: &Status, now_ms: u64) -> bool {
+    let at = status.telemetry.at_ms;
+    at > 0 && at <= now_ms && now_ms - at <= 7000
+}
+
+fn operating_state(status: &Status) -> (&'static str, &'static str, Tone) {
+    if status.config.paused {
+        ("已暂停", "正在撤销 MacFlow 施加的控制。", Tone::Muted)
+    } else if status.config.observe_only {
+        (
+            "观察模式",
+            "采集资源与应用状态，暂不施加新调度。",
+            Tone::Neutral,
+        )
+    } else if !status.helper_connected {
+        (
+            "管理受限",
+            "管理员助手未连接，外部进程优先级不可调节。",
+            Tone::Warning,
+        )
+    } else {
+        (
+            "管理已启用",
+            "根据有效采样与明确的应用规则决定控制。",
+            Tone::Positive,
+        )
+    }
+}
