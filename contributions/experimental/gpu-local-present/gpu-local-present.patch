+                fprintf(stderr, "[mclmetal] local present skipped: GPU command status=%llu\n", status);
+                return;
+            }
+            dispatch_async(dispatch_get_main_queue(), ^{
+                if (![NSThread isMainThread]) {
+                    fprintf(stderr, "[mclmetal] local present skipped: guest main queue is not on main thread\n");
+                    return;
+                }
+                pthread_mutex_lock(&gLocalPresentLock);
+                BOOL accepted = ![state[@"cancelled"] boolValue] && [state[@"phase"] isEqualToString:@"accepted"];
+                pthread_mutex_unlock(&gLocalPresentLock);
+                // The synchronous local commit runs on this same main thread.
+                // This task cannot run before its success/failure verdict; a
+                // queued completion after a failed commit must not present.
+                if (!accepted) {
+                    fprintf(stderr, "[mclmetal] local present skipped: host commit was not accepted\n");
+                    return;
+                }
+                for (id drawable in drawables) {
+                    @try {
+                        if (gTrace) fprintf(stderr, "[mclmetal] local present on guest main thread drawable=%s\n", object_getClassName(drawable));
+                        ((void(*)(id, SEL))objc_msgSend)(drawable, sel_registerName("present"));
+                    } @catch (NSException *exception) {
+                        fprintf(stderr, "[mclmetal] local present exception: %s: %s\n", exception.name.UTF8String, exception.reason.UTF8String);
+                    }
+                }
+            });
+            // gEvHandled tracks enqueueing only, never main-queue execution.
+        }, @"addCompletedHandler:");
+        NSDictionary *registered = mcl_rpc(@{@"c": @"msg", @"h": @(command->_h),
+                                             @"sel": @"addCompletedHandler:", @"args": @[encoded]});
+        if (registered[@"x"]) {
+            [NSException raise:@"MCLLocalPresentRegistrationFailed" format:@"%@", registered[@"x"]];
+        }
+        if (gTrace) fprintf(stderr, "[mclmetal] local present completion armed h=%llu\n", command->_h);
+        // Synchronous RPC reports native Objective-C commit rejection. Earlier
+        // batch work was flushed before registration; no fast commit is queued.
+        NSDictionary *committed = mcl_rpc(@{@"c": @"msg", @"h": @(command->_h),
+                                            @"sel": @"commit", @"args": @[]});
+        if (committed[@"x"]) {
+            [NSException raise:@"MCLLocalPresentCommitFailed" format:@"%@", committed[@"x"]];
+        }
+        pthread_mutex_lock(&gLocalPresentLock);
+        state[@"phase"] = @"accepted";
+        [state[@"drawables"] removeAllObjects];
+        pthread_mutex_unlock(&gLocalPresentLock);
+        if (gTrace) fprintf(stderr, "[mclmetal] local present host commit accepted h=%llu\n", command->_h);
+    } @catch (NSException *exception) {
+        pthread_mutex_lock(&gLocalPresentLock);
+        state[@"cancelled"] = @YES;
+        state[@"phase"] = @"failed";
+        [state[@"drawables"] removeAllObjects];
+        pthread_mutex_unlock(&gLocalPresentLock);
+        if (encoded) local_present_cancel_block(encoded);
+        [drawables release];
+        @throw; // caller receives failure; internal completion cannot present it
+    }
+    [drawables release];
+    return YES;
 }
 
