+            let mut value = cpu(op, base | dst_tag, if op == OP_ZERO { 4095 } else { 0xcd }, 4095);
+            assert!(!call(&mut value, true));
+        }
+        for (destination, source, length) in [
+            (0 | dst_tag, base | src_tag, 1),
+            (base | dst_tag, 0 | src_tag, 1),
+            (mem::COMMPAGE_SPAN_START | dst_tag, base | src_tag, 1),
+            (base | dst_tag, (mem::COMMPAGE_SPAN_END - 1) | src_tag, 2),
+        ] {
+            let mut value = cpu(OP_COPY, destination, source, length);
+            let before = cpu(OP_COPY, destination, source, length);
+            assert!(!call(&mut value, true)); unchanged(&before, &value);
+        }
+    }
