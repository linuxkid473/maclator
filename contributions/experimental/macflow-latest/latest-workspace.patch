+fn performance(status: &Status, now_ms: u64, model: &mut PageModel) {
+    let t = &status.telemetry;
+    let fresh = sample_fresh(status, now_ms);
+    let (memory, tone) = memory_state(if fresh {
+        t.memory_pressure
+    } else {
+        MemoryPressure::Unknown
+    });
+    model.sections.push(section(
+        "内存与磁盘",
+        "换页与压缩为每次采样的页增量，未知数据不参与策略。",
+        vec![
+            Row::new("内存压力", "内存告警连续 3 个样本触发保护", memory)
+                .tone(tone)
+                .symbol("memorychip"),
+            Row::new(
+                "压缩内存",
+                "由系统管理，MacFlow 不清系统缓存",
+                bytes(fresh.then_some(t.compressed_bytes).flatten()),
+            )
+            .symbol("archivebox"),
+            Row::new(
+                "Swap 占用",
+                "保留系统换页能力",
+                bytes(fresh.then_some(t.swap_used_bytes).flatten()),
+            )
+            .symbol("internaldrive"),
+            Row::new(
+                "压缩 / 解压增量",
+                "每次采样的页数",
+                format!(
+                    "{} / {}",
+                    count(fresh.then_some(t.compressed_pages_delta).flatten()),
+                    count(fresh.then_some(t.decompressed_pages_delta).flatten())
+                ),
+            )
+            .symbol("arrow.left.arrow.right"),
+            Row::new(
+                "换入 / 换出增量",
+                "每次采样的页数",
+                format!(
+                    "{} / {}",
+                    count(fresh.then_some(t.swap_in_pages_delta).flatten()),
+                    count(fresh.then_some(t.swap_out_pages_delta).flatten())
+                ),
+            )
+            .symbol("arrow.up.arrow.down"),
+            Row::new(
+                "热状态",
+                "仅显示系统报告",
+                if fresh {
+                    t.thermal.clone().unwrap_or_else(|| "未知".into())
+                } else {
+                    "未知".into()
+                },
+            )
+            .symbol("thermometer.medium"),
+            Row::new(
+                "供电",
+                "未经验证的供电信息不参与调度决策",
+                if !fresh {
+                    "未知"
+                } else {
+                    match t.ac_power {
+                        Some(true) => "已接电",
+                        Some(false) => "电池供电",
+                        None => "未知",
+                    }
+                },
+            )
+            .symbol("powerplug"),
+        ],
+    ));
+
+    let gpu = &t.gpu;
+    let gpu_verified = status.capabilities.iter().any(|capability| {
+        capability.name == "GPU utilization / temperature" && capability.available
+    });
+    model.sections.push(section(
+        "GPU",
+        "原生应用以监测与诊断为主；未验证的指标显示未知。",
+        vec![
+            Row::new(
+                "驱动版本",
+                "保留现有 NVIDIA / Metal 调用与生命周期",
+                gpu.driver_version.as_deref().unwrap_or("未知"),
+            )
+            .symbol("cpu"),
+            Row::new(
+                "VRAM 占用",
+                "驱动接口报告",
+                bytes(fresh.then_some(gpu.vram_used_bytes).flatten()),
+            )
+            .symbol("memorychip"),
+            Row::new(
+                "驱动恢复计数",
+                "累计报告，不代表 MacFlow 重启桌面",
+                count(gpu.recovery_count),
+            )
+            .symbol("arrow.clockwise"),
+            Row::new(
+                "GPU 利用率",
+                "仅显示已验证的采样",
+                percentage(
+                    (fresh && gpu_verified)
+                        .then_some(gpu.utilization_percent)
+                        .flatten()
+                        .filter(|v| *v <= 100.0),
+                ),
+            )
+            .tone(
+                if gpu.utilization_percent.is_some() && fresh && gpu_verified {
+                    Tone::Neutral
+                } else {
+                    Tone::Muted
+                },
+            )
+            .symbol("gauge.with.dots.needle.50percent"),
+            Row::new(
+                "GPU 温度",
+                "仅显示已验证的采样",
+                (fresh && gpu_verified)
+                    .then_some(gpu.temperature_c)
+                    .flatten()
+                    .filter(|v| v.is_finite())
+                    .map(|v| format!("{v:.1} °C"))
+                    .unwrap_or_else(|| "未知".into()),
+            )
+            .tone(if gpu.temperature_c.is_some() && fresh && gpu_verified {
+                Tone::Neutral
+            } else {
+                Tone::Muted
+            })
+            .symbol("thermometer.medium"),
+        ],
