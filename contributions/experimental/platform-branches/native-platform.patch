+#include <strings.h>
+
+extern void *mcl_platform_copy(void *, const void *, size_t);
+extern void *mcl_platform_fill(void *, int, size_t);
+extern void mcl_platform_zero(void *, size_t);
+
+// The current Command Line Tools SDK omits the convenience header. Dyld's
+// documented interpose section consists of replacement/replacee pointer pairs.
+struct mcl_interpose_tuple { const void *replacement; const void *replacee; };
+__attribute__((used, section("__DATA,__interpose,interposing")))
+static const struct mcl_interpose_tuple memory_interposes[] = {
+    {(const void *)&mcl_platform_copy, (const void *)&memcpy},
+    {(const void *)&mcl_platform_copy, (const void *)&memmove},
+    {(const void *)&mcl_platform_fill, (const void *)&memset},
+    {(const void *)&mcl_platform_zero, (const void *)&bzero},
+};
