+#[derive(Default)]
+struct RuntimeFingerprintCache {
+    metadata: Option<serde_json::Value>,
+    fingerprint: Option<serde_json::Value>,
+}
+
+fn runtime_metadata(path: &std::path::Path) -> Result<serde_json::Value, String> {
+    use std::os::unix::fs::MetadataExt;
+    let link =
+        std::fs::symlink_metadata(path).map_err(|e| format!("Maclator path unavailable: {e}"))?;
+    let file = std::fs::metadata(path).map_err(|e| format!("Maclator file unavailable: {e}"))?;
+    if !file.is_file() {
+        return Err("Maclator path is not a regular runtime file".into());
+    }
+    let metadata = |m: &std::fs::Metadata| {
+        serde_json::json!({
+            "dev": m.dev(), "ino": m.ino(), "size": m.len(),
+            "mtime_secs": m.mtime(), "mtime_nanos": m.mtime_nsec(),
+            "ctime_secs": m.ctime(), "ctime_nanos": m.ctime_nsec(),
+        })
+    };
+    let target = if link.file_type().is_symlink() {
+        Some(
+            std::fs::read_link(path)
+                .map_err(|e| e.to_string())?
+                .to_string_lossy()
+                .into_owned(),
+        )
+    } else {
+        None
+    };
+    Ok(serde_json::json!({
+        "path": path.to_string_lossy(),
+        "resolved_path": std::fs::canonicalize(path).map_err(|e| e.to_string())?.to_string_lossy(),
+        "link_target": target, "path_metadata": metadata(&link), "file_metadata": metadata(&file),
+    }))
+}
+
+impl RuntimeFingerprintCache {
+    fn fingerprint(&mut self, path: &std::path::Path) -> Result<serde_json::Value, String> {
+        let before = runtime_metadata(path)?;
+        if self.metadata.as_ref() == Some(&before) {
+            if let Some(fingerprint) = &self.fingerprint {
+                return Ok(fingerprint.clone());
+            }
+        }
+        let requirement = optional_code_requirement(path)?;
+        // Unsigned installed runtimes are still identified by SHA256 plus
+        // stat/link identity. Full hashing runs only after metadata changes.
+        let hash = bounded_command_output(
+            std::process::Command::new("/usr/bin/shasum")
+                .args(["-a", "256"])
+                .arg(path),
+            false,
+        )?;
+        if !hash.success {
+            return Err("Maclator SHA256 verification failed".into());
+        }
+        let output = String::from_utf8(hash.bytes).map_err(|_| "invalid runtime hash output")?;
+        let hash = output
+            .split_whitespace()
+            .next()
+            .filter(|hash| hash.len() == 64 && hash.bytes().all(|b| b.is_ascii_hexdigit()))
+            .ok_or("Maclator SHA256 unavailable")?;
+        if runtime_metadata(path)? != before {
+            return Err("Maclator changed during fingerprint verification".into());
+        }
+        let fingerprint = serde_json::json!({
+            "runtime_requirement": requirement, "runtime_file": before,
+            "runtime_sha256": hash,
+        });
+        self.metadata = Some(before);
+        self.fingerprint = Some(fingerprint.clone());
+        Ok(fingerprint)
+    }
+}
