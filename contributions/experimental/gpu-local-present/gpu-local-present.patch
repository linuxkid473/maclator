+// ---- experimental local guest drawable presentation ----------------------------------
+// Default OFF. This revision accepts local presentation and its actual commit
+// only on the guest main thread, and reports real synchronous commit failures.
+// A proxy with no local drawable keeps the original command-buffer commit path.
+static char gLocalPresentKey;
+static pthread_mutex_t gLocalPresentLock = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL local_command_proxy(MCLProxy *command) {
+    return object_getClass(command) == gProxyClass &&
+           [command->_protos containsObject:@"MTLCommandBuffer"];
+}
+
+static BOOL local_guest_drawable(id drawable) {
+    if (!drawable || object_getClass(drawable) != objc_getClass("CAMetalDrawable")) return NO;
+    id texture = ((id(*)(id, SEL))objc_msgSend)(drawable, sel_registerName("texture"));
+    id layer = ((id(*)(id, SEL))objc_msgSend)(drawable, sel_registerName("layer"));
+    if (!texture || object_getClass(texture) != gProxyClass || !layer ||
+        object_getClass(layer) != objc_getClass("CAMetalLayer")) return NO;
+    id device = ((id(*)(id, SEL))objc_msgSend)(layer, sel_registerName("device"));
+    return device && object_getClass(device) == gProxyClass &&
+           [((MCLProxy *)texture)->_protos containsObject:@"MTLTexture"] &&
+           [((MCLProxy *)device)->_protos containsObject:@"MTLDevice"];
+}
+
+// Caller holds gLocalPresentLock. No host calls, queue flushes or user callbacks
+// occur while holding this state lock.
+static NSMutableDictionary *local_present_state(MCLProxy *command, NSString *initialPhase) {
+    NSMutableDictionary *state = objc_getAssociatedObject(command, &gLocalPresentKey);
+    if (!state) {
+        state = [NSMutableDictionary dictionaryWithObjectsAndKeys:
+                 [NSMutableArray array], @"drawables", initialPhase, @"phase", @NO, @"cancelled", nil];
+        objc_setAssociatedObject(command, &gLocalPresentKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    }
+    return state;
+}
+
+static BOOL local_present_record(MCLProxy *command, SEL selector, id drawable) {
+    if (!local_command_proxy(command) || !local_guest_drawable(drawable)) return NO;
+    if (strcmp(sel_getName(selector), "presentDrawable:") != 0) {
+        [NSException raise:@"MCLLocalPresentUnsupported"
+                    format:@"Experimental local presentation supports only presentDrawable:; %@ is not implemented", NSStringFromSelector(selector)];
+    }
+    if (![NSThread isMainThread]) {
+        [NSException raise:@"MCLLocalPresentThreadUnsupported" format:@"Experimental local present registration requires the guest main thread"];
+    }
+    // MTLCommandBuffer NotEnqueued=0, Enqueued=1, Committed=2.
+    uint64_t status = ((uint64_t(*)(id, SEL))objc_msgSend)(command, sel_registerName("status"));
+    if (status >= 2) {
+        [NSException raise:@"MCLLocalPresentInvalidState" format:@"presentDrawable: must precede commandBuffer commit (status=%llu)", status];
+    }
+    pthread_mutex_lock(&gLocalPresentLock);
+    NSMutableDictionary *state = local_present_state(command, @"pending");
+    NSMutableArray *drawables = state[@"drawables"];
+    BOOL pending = [state[@"phase"] isEqualToString:@"pending"];
+    BOOL duplicate = [drawables containsObject:drawable];
+    BOOL full = drawables.count >= 16;
+    if (pending && !duplicate && !full) [drawables addObject:drawable];
+    pthread_mutex_unlock(&gLocalPresentLock);
+    if (!pending || duplicate || full) {
+        [NSException raise:@"MCLLocalPresentInvalidState" format:@"Experimental present registration rejected (pending=%d duplicate=%d limit=%d)", pending, duplicate, full];
+    }
+    if (gTrace) fprintf(stderr, "[mclmetal] local present recorded h=%llu drawable=%s\n", command->_h, object_getClassName(drawable));
+    return YES;
+}
+
+static void local_present_cancel_block(NSDictionary *encoded) {
+    [gBlockLock lock];
+    [gBlocks removeObjectForKey:encoded[@"blk"]];
+    [gBlockLock unlock];
+}
+
+// YES means this function performed the only actual host commit. Both callers
+// must return immediately and must not encode/forward another commit afterward.
+static BOOL local_present_commit(MCLProxy *command) {
