+#!/bin/bash
+set -euo pipefail
+cd "$(dirname "$0")"
+platform_out="${OUT:-out}"
+mkdir -p "$platform_out"
+clang -arch arm64 -dynamiclib -O2 -fno-builtin -fno-stack-protector \
+    -install_name @rpath/libmclplatform.dylib \
+    interpose.c mclplatform.S -o "$platform_out/libmclplatform.dylib"
+codesign -f -s - "$platform_out/libmclplatform.dylib"
