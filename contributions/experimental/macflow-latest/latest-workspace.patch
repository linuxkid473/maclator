+#![forbid(unsafe_code)]
+//! Conservative, paired performance feedback for an individual optimization.
+//!
+//! All metrics are durations, so a larger controlled result is a regression.
+//! The caller must establish that each pair used equivalent workloads and
+//! verified measurements. This module cannot infer causality or validate a
+//! release gate from unpaired application telemetry.
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Metric {
+    InteractionP95,
+    BackgroundDuration,
+    UncontendedDuration,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Pair {
+    pub baseline: f64,
+    pub controlled: f64,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Assessment {
+    pub median_regression_percent: f64,
+    pub worse_pairs: usize,
+    pub total_pairs: usize,
+    pub disable: bool,
+    pub threshold_percent: f64,
+}
+
+fn exceeds_threshold(regression: f64, threshold: f64) -> bool {
+    // Ratios such as 103/100 round just above exactly 3%. Ignore only machine
+    // rounding at the strict boundary; real regressions still exceed it.
+    let rounding = 32.0 * f64::EPSILON * regression.abs().max(threshold).max(1.0);
+    regression - threshold > rounding
+}
+
+/// Requires 9..=31 finite, positive duration pairs. Disable only when both the
+/// median and at least ceil(2n/3) pairs exceed the metric's regression budget.
+/// Not meeting a separate 20% responsiveness improvement target is not itself
+/// a regression and never causes quarantine through this function.
+pub fn evaluate(metric: Metric, pairs: &[Pair]) -> Result<Assessment, String> {
+    if !(9..=31).contains(&pairs.len()) {
+        return Err("performance feedback requires between 9 and 31 paired measurements".into());
+    }
+    let threshold_percent = match metric {
+        Metric::InteractionP95 | Metric::UncontendedDuration => 3.0,
+        Metric::BackgroundDuration => 15.0,
+    };
+    let mut regressions = Vec::with_capacity(pairs.len());
+    for (index, pair) in pairs.iter().enumerate() {
+        if !pair.baseline.is_finite()
+            || !pair.controlled.is_finite()
+            || pair.baseline <= 0.0
+            || pair.controlled <= 0.0
+        {
+            return Err(format!(
+                "pair {index}: durations must be finite and greater than zero"
+            ));
+        }
+        let regression = (pair.controlled / pair.baseline - 1.0) * 100.0;
+        if !regression.is_finite() {
+            return Err(format!(
+                "pair {index}: duration ratio cannot be represented finitely"
+            ));
+        }
+        regressions.push(regression);
+    }
+    let worse_pairs = regressions
+        .iter()
+        .filter(|&&value| exceeds_threshold(value, threshold_percent))
+        .count();
+    regressions.sort_unstable_by(f64::total_cmp);
+    let middle = regressions.len() / 2;
+    let median_regression_percent = if regressions.len().is_multiple_of(2) {
+        // Half each term first so two large finite regressions cannot make the
+        // median overflow even though both inputs were individually accepted.
+        regressions[middle - 1] / 2.0 + regressions[middle] / 2.0
+    } else {
+        regressions[middle]
+    };
+    let required_worse_pairs = (2 * pairs.len()).div_ceil(3);
+    Ok(Assessment {
+        median_regression_percent,
+        worse_pairs,
+        total_pairs: pairs.len(),
+        disable: worse_pairs >= required_worse_pairs
+            && exceeds_threshold(median_regression_percent, threshold_percent),
+        threshold_percent,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pair(controlled: f64) -> Pair {
+        Pair {
+            baseline: 100.0,
+            controlled,
+        }
+    }
+
+    #[test]
+    fn accepts_only_nine_through_thirty_one_pairs() {
+        for count in [0, 1, 8, 32, 100] {
+            assert!(evaluate(Metric::InteractionP95, &vec![pair(100.0); count]).is_err());
+        }
+        for count in [9, 10, 30, 31] {
+            assert_eq!(
+                evaluate(Metric::InteractionP95, &vec![pair(100.0); count])
+                    .unwrap()
+                    .total_pairs,
+                count
+            );
+        }
+    }
+
+    #[test]
+    fn rejects_invalid_duration_on_either_side_and_ratio_overflow() {
+        for invalid in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY, 0.0, -0.0, -1.0] {
+            for baseline_invalid in [false, true] {
+                let mut pairs = vec![pair(100.0); 9];
+                if baseline_invalid {
+                    pairs[8].baseline = invalid;
+                } else {
+                    pairs[8].controlled = invalid;
+                }
+                assert!(evaluate(Metric::BackgroundDuration, &pairs).is_err());
+            }
+        }
+        let pairs = vec![
+            Pair {
+                baseline: f64::MIN_POSITIVE,
+                controlled: f64::MAX
+            };
+            9
+        ];
+        assert!(evaluate(Metric::InteractionP95, &pairs).is_err());
+    }
+
+    #[test]
+    fn strict_metric_budgets_do_not_quarantine_exact_threshold() {
+        for (metric, threshold) in [
+            (Metric::InteractionP95, 3.0),
+            (Metric::UncontendedDuration, 3.0),
+            (Metric::BackgroundDuration, 15.0),
+        ] {
+            let at_boundary = evaluate(metric, &vec![pair(100.0 + threshold); 9]).unwrap();
+            assert_eq!(at_boundary.threshold_percent, threshold);
+            assert_eq!(at_boundary.worse_pairs, 0);
+            assert!(!at_boundary.disable);
+            let above = evaluate(metric, &vec![pair(100.0 + threshold + 0.001); 9]).unwrap();
+            assert_eq!(above.worse_pairs, 9);
+            assert!(above.disable);
+        }
+    }
+
+    #[test]
+    fn a_single_large_outlier_does_not_disable_an_optimization() {
+        let mut pairs = vec![pair(100.0); 9];
+        pairs[4] = pair(10_000.0);
+        let result = evaluate(Metric::InteractionP95, &pairs).unwrap();
+        assert_eq!(result.median_regression_percent, 0.0);
+        assert_eq!(result.worse_pairs, 1);
+        assert!(!result.disable);
+    }
+
+    #[test]
+    fn persistent_regression_requires_ceil_two_thirds_of_pairs() {
+        for (count, required) in [(9, 6), (10, 7), (31, 21)] {
+            let mut pairs = vec![pair(100.0); count];
+            pairs[..required - 1].fill(pair(106.0));
+            let insufficient = evaluate(Metric::InteractionP95, &pairs).unwrap();
+            assert_eq!(insufficient.worse_pairs, required - 1);
+            assert!(insufficient.median_regression_percent > 3.0);
+            assert!(!insufficient.disable);
+            pairs[required - 1] = pair(106.0);
+            let persistent = evaluate(Metric::InteractionP95, &pairs).unwrap();
+            assert_eq!(persistent.worse_pairs, required);
+            assert!(persistent.disable);
+        }
+    }
+
+    #[test]
+    fn even_sample_median_averages_middle_values() {
+        let pairs: Vec<_> = [
+            101.0, 110.0, 109.0, 108.0, 102.0, 107.0, 106.0, 103.0, 105.0, 104.0,
+        ]
+        .into_iter()
+        .map(pair)
+        .collect();
+        let result = evaluate(Metric::InteractionP95, &pairs).unwrap();
+        assert!((result.median_regression_percent - 5.5).abs() < 1e-12);
+        assert_eq!(result.worse_pairs, 7);
+        assert!(result.disable);
+    }
+
+    #[test]
+    fn background_budget_differs_from_interaction_budget() {
+        let pairs = vec![pair(110.0); 9];
+        assert!(evaluate(Metric::InteractionP95, &pairs).unwrap().disable);
+        assert!(
+            !evaluate(Metric::BackgroundDuration, &pairs)
+                .unwrap()
+                .disable
+        );
+        assert!(
+            evaluate(Metric::BackgroundDuration, &vec![pair(116.0); 9])
+                .unwrap()
+                .disable
+        );
+    }
+
+    #[test]
+    fn improvement_below_twenty_percent_or_no_effect_is_not_a_regression() {
+        for controlled in [80.0, 90.0, 99.0, 100.0, 101.0] {
+            let result = evaluate(Metric::InteractionP95, &vec![pair(controlled); 9]).unwrap();
+            assert_eq!(result.worse_pairs, 0);
+            assert!(!result.disable);
+        }
+    }
+
+    #[test]
+    fn very_large_finite_regressions_keep_a_finite_even_median() {
+        let pairs = vec![
+            Pair {
+                baseline: 1.0,
+                controlled: 1.7e306
+            };
+            10
+        ];
+        let result = evaluate(Metric::UncontendedDuration, &pairs).unwrap();
+        assert!(result.median_regression_percent.is_finite());
+        assert!(result.disable);
+    }
+}
