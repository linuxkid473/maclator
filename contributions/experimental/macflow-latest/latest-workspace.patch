+//! Native range charts. Unknown samples and real time gaps break the line.
+//! A drawn point always keeps its observed timestamp; no data is generated.
+use objc2::rc::Retained;
+use objc2::runtime::NSObjectProtocol;
+use objc2::{DefinedClass, MainThreadOnly, define_class, msg_send};
+use objc2_app_kit::{NSAccessibility, NSAccessibilityImageRole, NSBezierPath, NSColor, NSView};
+use objc2_foundation::{MainThreadMarker, NSPoint, NSRect, NSString};
+use std::{
+    cell::RefCell,
+    panic::{AssertUnwindSafe, catch_unwind},
+};
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Point {
+    pub at_ms: u64,
+    pub value: Option<f64>,
+}
+
+pub(super) struct ChartIvars {
+    points: RefCell<Vec<Point>>,
+    ceiling: f64,
+    purple: bool,
+    span_ms: u64,
+    max_gap_ms: u64,
+    end_ms: u64,
+}
+
+define_class!(
+    #[unsafe(super = NSView)]
+    #[thread_kind = MainThreadOnly]
+    #[ivars = ChartIvars]
+    pub(super) struct ChartView;
+    unsafe impl NSObjectProtocol for ChartView {}
+    impl ChartView {
+        #[unsafe(method(drawRect:))]
+        fn draw_rect(&self, _: NSRect) {
+            let _ = catch_unwind(AssertUnwindSafe(|| self.paint()));
+        }
+    }
+);
+
+impl ChartView {
+    /// Default live chart: two minutes, ending at the last received sample.
+    /// Display an explicit historical range. Samples after end_ms are
+    /// excluded. Both range and gap tolerance are supplied by the caller so
+    /// 30-second aggregates do not inherit the live chart's seven-second gap.
+    #[allow(clippy::too_many_arguments)]
+    pub fn with_range(
+        mtm: MainThreadMarker,
+        frame: NSRect,
+        points: Vec<Point>,
+        ceiling: f64,
+        purple: bool,
+        span_ms: u64,
+        max_gap_ms: u64,
+        end_ms: u64,
+    ) -> Retained<Self> {
+        let span_ms = span_ms.max(1);
+        let points = normalize_points(points, span_ms, end_ms);
+        let ceiling = if ceiling.is_finite() && ceiling > 0.0 {
+            ceiling
+        } else {
+            1.0
+        };
+        let this = Self::alloc(mtm).set_ivars(ChartIvars {
+            points: RefCell::new(points),
+            ceiling,
+            purple,
+            span_ms,
+            max_gap_ms,
+            end_ms,
+        });
+        let this: Retained<Self> = unsafe { msg_send![super(this), initWithFrame: frame] };
+        this.setAccessibilityElement(true);
+        // NSAccessibilityImageRole is an immutable AppKit constant. A chart
+        // has a descriptive value rather than interactive control semantics.
+        unsafe { this.setAccessibilityRole(Some(NSAccessibilityImageRole)) };
+        this.set_description(
+            if purple {
+                "压缩内存趋势"
+            } else {
+                "CPU 活动趋势"
+            },
+            "仅显示真实采样；未知值和采样间断处留空。",
+        );
+        this
+    }
+
+    /// Give VoiceOver the page's exact title and range/budget qualification.
+    /// The value summary is derived from the same points used by the renderer.
+    pub fn set_description(&self, title: &str, context: &str) {
+        self.setAccessibilityLabel(Some(&NSString::from_str(title)));
+        self.setAccessibilityHelp(Some(&NSString::from_str(context)));
+        let ivars = self.ivars();
+        let summary = value_summary(
+            &ivars.points.borrow(),
+            ivars.span_ms,
+            ivars.end_ms,
+            ivars.ceiling,
+            ivars.purple,
+        );
+        self.setAccessibilityValueDescription(Some(&NSString::from_str(&summary)));
+    }
+
+    fn paint(&self) {
+        let bounds = self.bounds();
+        let width = bounds.size.width;
+        let height = bounds.size.height;
+        if !width.is_finite() || !height.is_finite() || width <= 0.0 || height <= 0.0 {
+            return;
+        }
+        let inset_x = 4_f64.min(width / 2.0);
+        let inset_y = 4_f64.min(height / 2.0);
+        let plot_width = (width - 2.0 * inset_x).max(0.0);
+        let plot_height = (height - 2.0 * inset_y).max(0.0);
+        let origin = NSPoint::new(bounds.origin.x + inset_x, bounds.origin.y + inset_y);
+        NSColor::separatorColor()
+            .colorWithAlphaComponent(0.4)
+            .setStroke();
+        for part in 0..=4 {
+            let y = origin.y + plot_height * part as f64 / 4.0;
+            let grid = NSBezierPath::bezierPath();
+            grid.moveToPoint(NSPoint::new(origin.x, y));
+            grid.lineToPoint(NSPoint::new(origin.x + plot_width, y));
+            grid.setLineWidth(0.5);
+            grid.stroke();
+        }
+        let ivars = self.ivars();
+        let points = ivars.points.borrow();
+        let color = if ivars.purple {
+            NSColor::systemPurpleColor()
+        } else {
+            NSColor::systemBlueColor()
+        };
+        let path = NSBezierPath::bezierPath();
+        let coordinate = |sample: PlotPoint| {
+            NSPoint::new(
+                origin.x + plot_width * sample.x,
+                origin.y + plot_height * sample.y,
+            )
+        };
+        let last = visit_plot_points(
+            &points,
+            ivars.ceiling,
+            ivars.span_ms,
+            ivars.max_gap_ms,
+            ivars.end_ms,
+            |sample| {
+                let point = coordinate(sample);
+                if sample.connect {
+                    path.lineToPoint(point);
+                } else {
+                    path.moveToPoint(point);
+                }
+            },
+        );
+        color.setStroke();
+        path.setLineWidth(2.0);
+        path.stroke();
+        // The endpoint uses the latest sample's real time coordinate. An
+        // unknown latest sample has no endpoint indicator.
+        if let Some(last) = last {
+            let point = coordinate(last);
+            color.setFill();
+            NSBezierPath::bezierPathWithOvalInRect(super::rect(
+                point.x - 2.5,
+                point.y - 2.5,
+                5.0,
+                5.0,
+            ))
+            .fill();
+        }
+    }
+}
+
+fn valid_value(value: Option<f64>) -> Option<f64> {
+    value.filter(|value| value.is_finite() && *value >= 0.0)
+}
+
+fn normalize_points(mut points: Vec<Point>, span_ms: u64, end_ms: u64) -> Vec<Point> {
+    let start_ms = end_ms.saturating_sub(span_ms);
+    points.retain(|point| (start_ms..=end_ms).contains(&point.at_ms));
+    points.sort_by_key(|point| point.at_ms);
+    points.reverse();
+    points.dedup_by_key(|point| point.at_ms);
+    points.reverse();
+    points
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct PlotPoint {
+    x: f64,
+    y: f64,
+    connect: bool,
+}
+
+/// Shared drawing geometry, independent of Cocoa, for real timestamp and gap
+/// tests. Does not allocate a second trace when AppKit repaints the chart.
+fn visit_plot_points(
+    points: &[Point],
+    ceiling: f64,
+    span_ms: u64,
+    max_gap_ms: u64,
+    end_ms: u64,
+    mut visit: impl FnMut(PlotPoint),
+) -> Option<PlotPoint> {
+    let span_ms = span_ms.max(1);
+    let start_ms = end_ms.saturating_sub(span_ms);
+    let mut previous = None;
+    let mut last = None;
+    for sample in points
+        .iter()
+        .filter(|point| (start_ms..=end_ms).contains(&point.at_ms))
+    {
+        let Some(value) = valid_value(sample.value) else {
+            previous = None;
+            last = None;
+            continue;
+        };
+        let sample_point = PlotPoint {
+            // Express relative to the explicit range end, including an early
+            // epoch where saturating start arithmetic would shorten the span.
+            x: (1.0 - (end_ms - sample.at_ms) as f64 / span_ms as f64).clamp(0.0, 1.0),
+            y: (value / ceiling).clamp(0.0, 1.0),
+            connect: previous.is_some_and(|previous| {
+                sample.at_ms > previous && sample.at_ms - previous <= max_gap_ms
+            }),
+        };
+        visit(sample_point);
+        previous = Some(sample.at_ms);
+        last = Some(sample_point);
+    }
+    last
+}
+
+fn span_label(span_ms: u64) -> String {
+    let seconds = span_ms / 1000;
+    if seconds >= 86400 && seconds % 86400 == 0 {
+        format!("{} 天", seconds / 86400)
+    } else if seconds >= 3600 && seconds % 3600 == 0 {
+        format!("{} 小时", seconds / 3600)
+    } else if seconds >= 60 && seconds % 60 == 0 {
+        format!("{} 分钟", seconds / 60)
+    } else {
+        format!("{seconds} 秒")
+    }
+}
+
+fn value_summary(
+    points: &[Point],
+    span_ms: u64,
+    end_ms: u64,
+    ceiling: f64,
+    purple: bool,
+) -> String {
+    let known = points
+        .iter()
+        .filter(|point| valid_value(point.value).is_some())
+        .count();
+    let unit = if purple { " GiB" } else { "%" };
+    let latest = points
+        .last()
+        .and_then(|point| {
+            valid_value(point.value).map(|value| {
+                format!(
+                    "最近采样 {value:.1}{unit}，距区间结束 {} 秒",
+                    end_ms.saturating_sub(point.at_ms) / 1000,
+                )
+            })
+        })
+        .unwrap_or_else(|| "最近采样值未知".into());
+    format!(
+        "过去 {}，{} 个已知采样，{} 个未知采样；{}；纵轴 0 至 {:.1}{}。没有记录的时段留空。",
+        span_label(span_ms),
+        known,
+        points.len().saturating_sub(known),
+        latest,
+        ceiling,
+        unit,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn point(at_ms: u64, value: Option<f64>) -> Point {
+        Point { at_ms, value }
+    }
+
+    #[test]
+    fn explicit_range_ignores_future_and_endpoint_uses_real_timestamp() {
+        let points = vec![
+            point(200_000, Some(50.0)),
+            point(300_000, Some(100.0)),
+            point(500_001, Some(25.0)),
+        ];
+        let mut plotted = vec![];
+        let last = visit_plot_points(&points, 100.0, 400_000, 120_000, 500_000, |sample| {
+            plotted.push(sample)
+        })
+        .unwrap();
+        assert_eq!(plotted.len(), 2);
+        assert_eq!(last.x, 0.5);
+        assert_eq!(last.y, 1.0);
+        assert_ne!(last.x, 1.0);
+    }
+
+    #[test]
+    fn unknown_invalid_and_real_time_gaps_break_line_segments() {
+        let points = vec![
+            point(100_000, Some(20.0)),
+            point(101_000, Some(30.0)),
+            point(102_000, None),
+            point(103_000, Some(40.0)),
+            point(110_001, Some(50.0)),
+            point(111_000, Some(f64::NAN)),
+            point(112_000, Some(60.0)),
+        ];
+        let mut plotted = vec![];
+        visit_plot_points(&points, 100.0, 120_000, 7000, 120_000, |sample| {
+            plotted.push(sample)
+        });
+        assert_eq!(
+            plotted
+                .iter()
+                .map(|sample| sample.connect)
+                .collect::<Vec<_>>(),
+            [false, true, false, false, false]
+        );
+    }
+
+    #[test]
+    fn latest_unknown_sample_has_no_endpoint_dot_and_no_fake_summary_value() {
+        let points = vec![point(1000, Some(30.0)), point(2000, None)];
+        assert_eq!(
+            visit_plot_points(&points, 100.0, 120_000, 7000, 2000, |_| {}),
+            None
+        );
+        let summary = value_summary(&points, 120_000, 2000, 100.0, false);
+        assert!(summary.contains("1 个已知采样"));
+        assert!(summary.contains("1 个未知采样"));
+        assert!(summary.contains("最近采样值未知"));
