+    fn check_freshness(&mut self, now_ms: u64) -> Option<String> {
+        let overdue = self.last_completed_ms.map_or_else(
+            || now_ms.saturating_sub(self.started_ms) > COMPATIBILITY_INITIAL_BUDGET_MS,
+            |last| now_ms.saturating_sub(last) > COMPATIBILITY_FRESHNESS_MS,
+        );
+        if overdue {
+            self.unavailable("signature verification exceeded its freshness budget")
+        } else {
+            None
+        }
+    }
