+
+    let rows = if status.runtimes.is_empty() {
+        vec![
+            Row::new(
+                "暂无连接的 ARM 应用",
+                "ARM 应用启动后会报告转译与 GPU 桥接统计",
+                "等待运行时",
+            )
+            .tone(Tone::Muted)
+            .symbol("arrow.triangle.swap"),
+        ]
+    } else {
+        status
+            .runtimes
+            .iter()
+            .map(|runtime| {
+                Row::new(
+                    basename(&runtime.source_app),
+                    format!(
+                        "PID {} · {} 次汇总采样 · {} 次桥接调用",
+                        runtime.pid, runtime.samples, runtime.bridge_calls
+                    ),
+                    format!("{:.2} ms 等待", runtime.bridge_wait_ns as f64 / 1_000_000.0),
+                )
+                .tone(if runtime.qos_failures > 0 {
+                    Tone::Warning
+                } else {
+                    Tone::Neutral
+                })
+                .symbol("arrow.triangle.swap")
+                .detail(format!(
+                    "累计桥接等待 · QoS 失败 {} · {}。转译 95% 原生性能目标需单独基准验收。",
+                    runtime.qos_failures, runtime.source_app
+                ))
+            })
