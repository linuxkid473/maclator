+            history
+                .points
+                .iter()
+                .filter(|p| p.epoch_seconds.saturating_mul(1000) >= start)
+                .map(|p| {
+                    (
+                        Point {
+                            at_ms: p.epoch_seconds.saturating_mul(1000),
+                            value: p.cpu,
+                        },
+                        Point {
+                            at_ms: p.epoch_seconds.saturating_mul(1000),
+                            value: p.compressed_gib,
+                        },
+                    )
+                })
+                .unzip()
+        };
+        let count = cpu
+            .iter()
+            .filter(|p| p.value.is_some() && p.at_ms >= start && p.at_ms <= end)
+            .count();
+        let left = ["2 分钟前", "1 小时前", "24 小时前", "7 天前"][range];
+        add_label(
+            self.mtm(),
+            &c,
+            "CPU 活动",
+            Style::Section,
+            rect(20., offset + 17., 200., 24.),
+        );
+        add_label(
+            self.mtm(),
+            &c,
+            "全机占用 · 0–100%",
+            Style::Caption,
+            rect(width - 206., offset + 21., 186., 20.),
+        );
+        let chart = ChartView::with_range(
+            self.mtm(),
+            rect(20., offset + 56., width - 40., 88.),
+            cpu,
+            100.,
+            false,
+            span,
+            gap,
+            end,
+        );
+        chart.set_description(
+            "CPU 活动",
+            if live {
+                "当前会话，最近两分钟"
+            } else {
+                left
+            },
+        );
+        c.addSubview(&chart);
+        add_label(
+            self.mtm(),
+            &c,
+            left,
+            Style::Caption,
+            rect(20., offset + 155., 150., 20.),
+        );
+        add_label(
+            self.mtm(),
+            &c,
+            "现在",
+            Style::Caption,
+            rect(width - 100., offset + 155., 80., 20.),
+        )
+        .setAlignment(NSTextAlignment::Right);
+        if count < 2 {
+            add_label(
+                self.mtm(),
+                &c,
+                if live {
+                    "正在积累本次会话的真实采样…"
+                } else {
+                    "此范围暂未积累足够记录"
+                },
+                Style::Secondary,
+                rect(34., offset + 87., width - 70., 22.),
+            );
+        }
+        if both {
+            let ceiling = memory
+                .iter()
+                .filter(|p| p.at_ms >= start && p.at_ms <= end)
+                .filter_map(|p| p.value)
+                .fold(1_f64, f64::max)
+                .ceil();
+            add_label(
+                self.mtm(),
+                &c,
+                "压缩内存",
+                Style::Section,
+                rect(20., offset + 188., 220., 24.),
+            );
+            add_label(
+                self.mtm(),
+                &c,
+                &format!("0–{ceiling:.0} GiB"),
+                Style::Caption,
+                rect(width - 155., offset + 190., 135., 20.),
+            );
+            let mem = ChartView::with_range(
+                self.mtm(),
+                rect(20., offset + 226., width - 40., 60.),
+                memory,
+                ceiling,
+                true,
+                span,
+                gap,
+                end,
+            );
+            mem.set_description(
+                "压缩内存",
+                if live {
+                    "当前会话，最近两分钟"
+                } else {
+                    left
+                },
+            );
+            c.addSubview(&mem);
+            let copy = if live {
+                "本次会话的真实采样 · 断联与无效数据留空".into()
+            } else {
+                format!("本机聚合历史 · 当前范围 {count} 个有效 CPU 点 · 缺失数据留空")
+            };
+            add_label(
+                self.mtm(),
+                &c,
+                &copy,
+                Style::Caption,
+                rect(20., offset + 303., width - 40., 20.),
+            )
+            .setToolTip(Some(&NSString::from_str(&copy)));
+        }
+        let mut next = y + height + 18.;
+        if both && !live && (history.error.is_some() || history.truncated) {
+            let mut copy = history.error.clone().unwrap_or_default();
