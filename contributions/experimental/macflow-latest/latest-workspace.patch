+#!/usr/bin/env python3
+"""Synthetic feedback classifier/XPC/revocation test, not performance evidence.
+
+Uses only the disposable compute fixture and verified probe from the comparison
+runner. Restores modes, adds fixture protection and removes synthetic history.
+"""
+import json
+import os
+from pathlib import Path
+import subprocess
+import time
+from compare_responsiveness import CLI, FIXTURE, PROBE_APP, ROOT, invoke, nice_of, write_json
+
+support = Path.home() / "Library/Application Support/MacFlow"
+history = support / "performance-feedback.json"
+original_history = history.read_bytes() if history.exists() else None
+initial = invoke("status")["config"]
+selector = f"path:{FIXTURE.resolve()}"
+report = {"synthetic_measurements": True, "not_release_performance_evidence": True, "restoration_errors": []}
+fixture = probe = None
+
+def rejected(path):
+    result = subprocess.run([str(CLI), "feedback", str(path)], capture_output=True, text=True, timeout=8)
+    assert result.returncode != 0, "invalid evidence unexpectedly accepted"
+    return result.stderr.strip()
+
+try:
+    if os.geteuid() == 0:
+        raise RuntimeError("run this controller test as the logged-in user")
+    invoke("mode", "auto")
+    invoke("resume")
+    invoke("rule", "background", selector)
+    invoke("observe", "off")
+    fixture = subprocess.Popen([str(FIXTURE), "--duration", "30", "--threads", "30"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    original_nice = nice_of(fixture.pid)
+    probe = subprocess.Popen(["/usr/bin/open", "-n", "-W", str(PROBE_APP), "--args", "--warmup", "12", "--duration", "12", "--json", str(ROOT / "validation/feedback-probe.json")], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    deadline = time.monotonic() + 20
+    while time.monotonic() < deadline:
+        status = invoke("status")
+        control = next((c for c in status["controls"] if c["identity"]["pid"] == fixture.pid), None)
+        if control and nice_of(fixture.pid) > original_nice:
+            break
+        time.sleep(0.2)
+    else:
+        raise RuntimeError("dedicated fixture never received a verified control")
+    report["real_control_before_feedback"] = control
+    evidence = {
+        "evidence_id": f"synthetic-pipeline-test-{time.monotonic_ns()}", "selector": selector,
+        "scenario": "SYNTHETIC classifier and lease-revocation integration test",
+        "compatibility": json.loads((support / "compatibility.json").read_text()),
+        "metric": "interaction_p95", "pairs": [{"baseline": 100.0, "controlled": 130.0}] * 9,
+        "matched_workload": True, "all_control_rounds_applied": True, "all_baseline_rounds_uncontrolled": True,
+    }
+    evidence_path = ROOT / "validation/synthetic-feedback-test-input.json"
+    write_json(evidence_path, evidence)
+    result = invoke("feedback", str(evidence_path))
+    assert result["disabled"] is True
+    started = time.monotonic()
+    while time.monotonic() - started < 3:
+        if nice_of(fixture.pid) == original_nice:
+            break
+        time.sleep(0.05)
+    assert nice_of(fixture.pid) == original_nice
+    assert fixture.poll() is None, "fixture ended before restoration was verified"
+    report["feedback_result"] = result
+    report["restore_after_quarantine_seconds"] = time.monotonic() - started
+    report["nice_restored_while_fixture_still_running"] = True
+    assert invoke("feedback", str(evidence_path)) == result
+    report["identical_evidence_is_idempotent"] = True
+    changed = dict(evidence, pairs=[{"baseline": 100.0, "controlled": 101.0}] * 9)
+    write_json(evidence_path, changed)
+    report["changed_evidence_id_rejected"] = rejected(evidence_path)
+    stale = dict(evidence, evidence_id=evidence["evidence_id"] + "-stale", compatibility={"different_version": True})
+    write_json(evidence_path, stale)
+    report["stale_compatibility_rejected"] = rejected(evidence_path)
+    unverified = dict(evidence, evidence_id=evidence["evidence_id"] + "-unverified", matched_workload=False)
+    write_json(evidence_path, unverified)
+    report["unverified_workload_rejected"] = rejected(evidence_path)
+    report["passed"] = True
+finally:
+    for process in (fixture, probe):
+        if process is not None and process.poll() is None:
+            process.terminate()
+            try:
+                process.communicate(timeout=3)
