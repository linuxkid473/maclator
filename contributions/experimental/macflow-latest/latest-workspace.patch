+        let trace = self.ivars().trace.borrow();
+        let history = self.ivars().history.borrow();
+        let span = [120_000, 3_600_000, 86_400_000, 604_800_000][range];
+        let end = if live {
+            macflow_platform::now_ms()
+        } else {
+            epoch_seconds().saturating_mul(1000)
+        };
+        let gap = if live {
+            7000
+        } else {
+            90_000u64.max(span / history::MAX_POINTS as u64 * 2)
+        };
+        let start = end.saturating_sub(span);
+        let (cpu, memory): (Vec<Point>, Vec<Point>) = if live {
+            (
+                trace.cpu.iter().cloned().collect(),
+                trace.memory.iter().cloned().collect(),
+            )
