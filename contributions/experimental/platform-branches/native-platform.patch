+#!/usr/bin/env python3
+"""Build and compare real libc memory calls with opt-in Maclator interception."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--runtime", type=Path, required=True)
+    parser.add_argument("--sysroot", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--deadline", type=float, default=30)
+    args = parser.parse_args()
+    if not 0 < args.deadline <= 60:
+        parser.error("deadline must be between 0 and 60 seconds")
+    args.output = args.output.resolve()
+    args.output.mkdir(parents=True, exist_ok=True)
+    root = Path(__file__).resolve().parents[1]
+    source = root / "tests/native_platform/memory_primitives.c"
+    shim = args.output / "shim/libmclplatform.dylib"
+    records = []
+
+    def run(name, command, extra=None, check_probe=False, bridge=False):
+        env = dict(os.environ)
+        for key in list(env):
+            if key.startswith("MACLATOR_") or key.startswith("DYLD_") or key.startswith("MCL_"):
+                env.pop(key, None)
+        env.update(extra or {})
+        start = time.monotonic()
+        process = subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                   text=True, start_new_session=True)
+        timeout = False
+        try:
+            stdout, stderr = process.communicate(timeout=args.deadline)
+        except subprocess.TimeoutExpired:
+            timeout = True
+            os.killpg(process.pid, signal.SIGKILL)
+            stdout, stderr = process.communicate()
+        except BaseException:
+            os.killpg(process.pid, signal.SIGKILL)
+            process.communicate()
+            raise
+        (args.output / f"{name}.stdout.log").write_text(stdout)
+        (args.output / f"{name}.stderr.log").write_text(stderr)
+        passed = not timeout and process.returncode == 0
+        checksums = re.findall(r"^CHECKSUM=(\d+)$", stdout, re.M)
+        stats = [dict(zip(("copy", "fill", "bytes", "declined"), map(int, fields)))
+                 for fields in re.findall(r"native platform: copy=(\d+) fill=(\d+) bytes=(\d+) declined=(\d+)", stderr)]
+        if check_probe:
+            markers = ("PASS: copy/fill/zero sizes", "PASS: overlapping memmove",
+                       "PASS: read-only source", "PASS: native child scrub")
+            passed &= all(marker in stdout for marker in markers) and len(checksums) == 2 and len(set(checksums)) == 1
+            if name != "native-x86_64":
+                passed &= stdout.count("PASS: private ABI") == 2
+            if bridge:
+                # More than the direct SVC checks: prove actual library symbols
+                # were interposed in both the initial process and ARM child.
+                passed &= len(stats) == 2 and all(s["copy"] >= 30 and s["fill"] >= 40 for s in stats)
+                passed &= stdout.count("PASS: mixed-tag real memmove sizes") == 2
+        record = {"name": name, "command": command, "environment": extra or {},
+                  "returncode": process.returncode, "timeout": timeout, "passed": bool(passed),
+                  "elapsed_seconds": time.monotonic() - start, "checksums": checksums, "native_calls": stats}
+        records.append(record)
+        (args.output / "results.json").write_text(json.dumps(records, indent=2) + "\n")
+        print(f"{name}: {'PASS' if passed else 'FAIL'} ({record['elapsed_seconds']:.2f}s)", flush=True)
+        return record
+
+    if not run("build-shim", ["/bin/bash", str(root / "platform/build.sh")],
+               {"OUT": str(shim.parent)})["passed"]:
+        return 1
+    for arch in ("x86_64", "arm64"):
+        binary = args.output / f"memory-{arch}"
+        if not run(f"compile-{arch}", ["/usr/bin/clang", "-arch", arch, "-O2", "-fno-builtin",
+                   str(source), "-o", str(binary)])["passed"]:
+            return 1
+    native = run("native-x86_64", [str(args.output / "memory-x86_64")], check_probe=True)
+    command = [str(args.runtime.resolve()), "--no-aot", "--sysroot", str(args.sysroot.resolve()),
+               str(args.output / "memory-arm64")]
+    off = run("arm-disabled", [*command, "--expect-disabled"], check_probe=True)
+    env = {"MACLATOR_NATIVE_PLATFORM": "1", "MACLATOR_PLATFORM_SHIM": str(shim), "MACLATOR_STATS": "1"}
+    on = run("arm-native-platform", [*command, "--expect-bridge"], env, check_probe=True, bridge=True)
+    redirected = run("arm-redirected-commpage", [*command, "--expect-bridge"],
+                     {**env, "MACLATOR_NO_COMMPAGE": "1"}, check_probe=True, bridge=True)
+    equal = native["checksums"] and all(record["checksums"] == native["checksums"]
+                                       for record in (off, on, redirected))
+    paths = [source, args.runtime.resolve(), shim, args.output / "memory-x86_64", args.output / "memory-arm64"]
+    hashes = {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
+    (args.output / "sha256.json").write_text(json.dumps(hashes, indent=2) + "\n")
+    (args.output / "summary.json").write_text(json.dumps({"matching_native_checksums": bool(equal),
+        "passed": bool(equal) and all(record["passed"] for record in records)}, indent=2) + "\n")
+    return 0 if equal and all(record["passed"] for record in records) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
