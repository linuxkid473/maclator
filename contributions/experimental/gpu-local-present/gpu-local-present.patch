+    NSDictionary *encoded = nil;
+    @try {
+        // MRC copies retain both the snapshot and cancellation state. Capture no
+        // command proxy, so command associated state cannot own itself in a cycle.
+        encoded = encodeBlock(^(id completedCommand) {
+            uint64_t status = 0;
+            @try {
+                if (!completedCommand || !local_command_proxy(completedCommand)) {
+                    fprintf(stderr, "[mclmetal] local present skipped: invalid completed command proxy\n");
+                    return;
+                }
+                status = ((uint64_t(*)(id, SEL))objc_msgSend)(completedCommand, sel_registerName("status"));
+            } @catch (NSException *exception) {
+                fprintf(stderr, "[mclmetal] local present skipped: completion status exception: %s: %s\n", exception.name.UTF8String, exception.reason.UTF8String);
+                return; // internal RPC failure must not escape the event pump
+            }
