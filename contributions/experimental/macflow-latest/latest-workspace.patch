+fn clear(view: &NSView) {
+    let views = view.subviews();
+    for v in views.iter() {
+        v.removeFromSuperview();
+    }
+}
+fn add_label(
+    mtm: MainThreadMarker,
+    parent: &NSView,
+    text: &str,
+    style: Style,
+    frame: NSRect,
+) -> Retained<NSTextField> {
+    let l = widgets::label(mtm, text, style, frame);
+    parent.addSubview(&l);
+    l
+}
+fn add_paragraph(
+    mtm: MainThreadMarker,
+    parent: &NSView,
+    text: &str,
+    style: Style,
+    frame: NSRect,
+) -> Retained<NSTextField> {
+    let l = widgets::paragraph(mtm, text, style, frame);
+    parent.addSubview(&l);
+    l
+}
+fn card(
+    mtm: MainThreadMarker,
+    parent: &NSView,
+    frame: NSRect,
+) -> (Retained<NSBox>, Retained<Canvas>) {
+    let b = widgets::card(mtm, frame);
+    let c = Canvas::new(mtm, rect(0., 0., frame.size.width, frame.size.height));
+    b.setContentView(Some(&c));
+    parent.addSubview(&b);
+    (b, c)
+}
+fn tone(t: Tone) -> Retained<NSColor> {
+    match t {
+        Tone::Neutral => NSColor::labelColor(),
+        Tone::Positive => NSColor::systemGreenColor(),
+        Tone::Warning => NSColor::systemOrangeColor(),
+        Tone::Critical => NSColor::systemRedColor(),
+        Tone::Muted => NSColor::secondaryLabelColor(),
+    }
+}
