+    };
+    model.sections.push(section(
+        "Maclator 运行时",
+        "保留每个 guest 线程独立的 GPU bridge 与同步顺序。",
+        rows,
+    ));
+
+    let mut feedback = status.performance_feedback.iter().collect::<Vec<_>>();
+    feedback.sort_by_key(|f| std::cmp::Reverse(f.at_ms));
+    let rows = if feedback.is_empty() {
+        vec![
+            Row::new(
+                "尚无配对测试结果",
+                "需要同一负载、相同条件下至少 9 对关闭 / 开启测试",
+                "等待证据",
+            )
+            .tone(Tone::Muted)
+            .symbol("chart.bar.xaxis"),
+        ]
+    } else {
+        feedback
+            .into_iter()
+            .map(|f| feedback_row(f, now_ms))
+            .collect()
+    };
+    model.sections.push(section(
+        "经过验证的性能反馈",
+        "每个场景独立报告；不从 CPU 占用推算全局 FPS 或交互延迟。",
+        rows,
+    ));
+}
+
+fn capability_row(capability: &Capability) -> Row {
+    let (name, symbol) = match capability.name.as_str() {
+        "External CPU nice" => ("外部进程优先级", "cpu"),
+        "GPU utilization / temperature" => ("GPU 利用率与温度", "gauge.with.dots.needle.50percent"),
+        "Maclator coordination" => ("Maclator 协同", "arrow.triangle.swap"),
+        "Disk policy" => ("合作任务磁盘策略", "internaldrive"),
+        name => (name, "checkmark.shield"),
+    };
+    let value = if capability.name == "GPU utilization / temperature" && capability.available {
+        "仅监测"
+    } else if capability.available {
+        "可调节"
+    } else if capability.name == "External CPU nice" {
+        "仅监测"
+    } else {
+        "能力未知"
+    };
+    let detail = match capability.name.as_str() {
+        "External CPU nice" if !capability.available => {
+            "需连接已验证身份的管理员助手；默认观察模式。"
+        }
+        "External CPU nice" => "只管理已明确允许的后台任务；每项控制有身份验证与恢复租约。",
+        "GPU utilization / temperature" if !capability.available => {
+            "当前驱动指标语义尚未验证，未知数据不参与决策。"
+        }
+        "Maclator coordination" => "版本化本机 socket、真实线程 QoS 与 GPU bridge 原子策略。",
+        "Disk policy" => "仅支持自有和合作任务；未验证的外部进程能力不进行控制。",
+        _ => capability.detail.as_str(),
+    };
+    Row::new(name, detail, value)
+        .tone(if capability.available {
+            Tone::Positive
+        } else {
+            Tone::Muted
+        })
+        .symbol(symbol)
+}
+
+fn verification_rows(status: &Status) -> Vec<Row> {
+    if status.pending_verification.is_empty() {
+        return vec![
+            Row::new(
+                "未报告待验收项目",
+                "仍以实施报告与真实测试证据为准",
+                "查看报告",
+            )
+            .tone(Tone::Muted)
+            .symbol("doc.text.magnifyingglass"),
+        ];
+    }
+    status
+        .pending_verification
+        .iter()
+        .map(|item| {
+            let title = match item.as_str() {
+                "Nine-round foreground/background comparison" => "九轮前后台对照",
+                "p95/p99 interaction and verified presentation timing" => {
+                    "交互 p95 / p99 与呈现时间"
+                }
+                "24-hour stress run" => "24 小时压力验证",
+                "Seven-day daily-use verification" => "七天日常使用验证",
+                "95% native translation performance (separate goal)" => {
+                    "Maclator 95% 原生性能独立基准"
+                }
+                text => text,
+            };
+            Row::new(title, "以对应场景的可验证测试为准", "待验收")
+                .tone(Tone::Muted)
+                .symbol("checklist")
+        })
+        .collect()
+}
+
+fn diagnostics(status: &Status, now_ms: u64, model: &mut PageModel) {
+    let rows = if status.capabilities.is_empty() {
+        vec![
+            Row::new("能力信息尚未加载", "等待本机服务报告", "能力未知")
+                .tone(Tone::Muted)
+                .symbol("questionmark.circle"),
+        ]
+    } else {
+        status.capabilities.iter().map(capability_row).collect()
+    };
+    model.sections.push(section(
+        "系统能力",
+        "可调节表示接口可用，是否施加控制仍由模式、保护规则与身份决定。",
+        rows,
+    ));
+
+    let mut rows = status
+        .telemetry
+        .errors
+        .iter()
+        .map(|error| {
+            Row::new("采样异常", error, "需核查")
+                .tone(Tone::Warning)
+                .symbol("exclamationmark.triangle")
+        })
+        .collect::<Vec<_>>();
+    if let Some(error) = &status.telemetry.gpu.error {
+        rows.push(
+            Row::new("GPU 异常", error, "停止相关优化")
+                .tone(Tone::Critical)
+                .symbol("exclamationmark.octagon"),
+        );
+    }
+    if rows.is_empty() {
+        rows.push(
+            Row::new(
+                "未报告采样或 GPU 异常",
+                "仅表示当前快照未报告错误",
+                "当前正常",
+            )
+            .tone(Tone::Positive)
+            .symbol("checkmark.circle"),
+        );
+    }
+    model.sections.push(section(
+        "异常与证据",
+        "驱动异常记录证据，不自动重启用户桌面。",
+        rows,
+    ));
+
+    let mut events = status.events.iter().collect::<Vec<_>>();
+    events.sort_by_key(|event| std::cmp::Reverse(event.at_ms));
+    let rows = if events.is_empty() {
+        vec![
+            Row::new("暂无事件", "策略、恢复和兼容变化会记录在这里", "等待事件")
+                .tone(Tone::Muted)
+                .symbol("clock"),
+        ]
+    } else {
+        events
+            .into_iter()
+            .map(|event| {
+                let lower = event.kind.to_ascii_lowercase();
+                let tone = if lower.contains("error") || lower.contains("failed") {
+                    Tone::Critical
+                } else if lower.contains("warning")
+                    || lower.contains("disable")
+                    || lower.contains("quarantine")
+                {
+                    Tone::Warning
+                } else {
+                    Tone::Neutral
+                };
+                Row::new(
+                    event_title(&event.kind),
+                    &event.message,
+                    relative_time(event.at_ms, now_ms),
+                )
+                .tone(tone)
+                .symbol("clock")
+            })
+            .collect()
+    };
+    model.sections.push(section(
+        "最近事件",
+        "最近事件优先显示；完整环形记录可导出到本机。",
+        rows,
+    ));
+    model.sections.push(section(
+        "待完成验证",
+        "未通过的能力保持实验状态。",
+        verification_rows(status),
+    ));
+    model.sections.push(section(
+        "诊断保存",
+        "所有诊断数据保存在本机。",
+        vec![
+            Row::new("细粒度记录", "最近五分钟的环形记录", "5 分钟")
+                .symbol("clock.arrow.circlepath"),
+            Row::new("聚合历史", "移除逐进程身份的长期统计", "7 天").symbol("chart.xyaxis.line"),
+            Row::new("容量预算", "历史与导出容量合计上限", "500 MB").symbol("internaldrive"),
+        ],
+    ));
+}
+
+fn event_title(kind: &str) -> &str {
+    match kind {
+        "startup" => "服务启动",
+        "mode" => "模式变化",
+        "pause" => "已暂停管理",
+        "resume" => "恢复运行",
+        "observation" => "观察模式变化",
+        "rule" => "应用规则变化",
+        "configuration" => "运行配置变化",
+        "configuration_error" => "配置保存异常",
+        "rule_disabled" => "规则已隔离",
+        "pressure" => "资源压力变化",
+        "helper" => "管理员助手",
+        "restore" | "recovery" | "control_restored" => "控制恢复",
+        "control_applied" => "已应用优先级控制",
+        "helper_rejected" => "助手拒绝请求",
+        "gpu_fault" => "GPU 故障",
+        "history_error" => "历史保存异常",
+        "compatibility" => "兼容性变化",
+        "feedback" | "performance_feedback" => "性能反馈",
+        "performance_rule_disabled" => "性能退步触发规则隔离",
+        "error" => "服务异常",
+        other => other,
+    }
+}
