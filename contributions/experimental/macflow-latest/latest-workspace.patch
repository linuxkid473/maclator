+fn persist_compatibility(state: &Shared, request: &CompatibilityPersistence) -> Result<(), String> {
+    let _mutation = CONFIGURATION_MUTATION
+        .lock()
+        .map_err(|_| "configuration unavailable")?;
+    let config = {
+        let mut s = state.lock().map_err(|_| "state unavailable")?;
+        if s.compatibility_generation != request.generation {
+            return Err("superseded compatibility generation".into());
+        }
+        s.status.config.observe_only = true;
+        // Read fresh mode/rules under the same mutation lock used by XPC.
+        s.status.config.clone()
+    };
+    storage::save_config(&config)?;
+    if let Some(signature) = &request.signature {
+        storage::atomic_json(&storage::user_dir().join("compatibility.json"), signature)?;
+    }
+    Ok(())
