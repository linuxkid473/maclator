#!/bin/zsh
# Launch the arm64 Chromium snapshot with GPU acceleration (ANGLE/Metal -> host GPU via Maclator).
# Usage: chromium-gpu [extra chromium args] [url]
pkill -f "maclator.*Chromium" 2>/dev/null
cd "$HOME/Downloads/chromium-arm64/chrome-mac/Chromium.app/Contents/MacOS" || exit 1
exec "$HOME/bin/maclator" --gpu --gpu-only --type=gpu-process ./Chromium --no-sandbox --disable-gpu-sandbox --disable-gpu-watchdog \
  --use-angle=metal --use-gl=angle --enable-gpu --ignore-gpu-blocklist \
  --user-data-dir="${CHROMIUM_DATA:-$HOME/chromium-data}" --no-first-run --no-default-browser-check \
  --remote-debugging-port=9333 "$@"
