+// ARM leaf entries. No constructors, allocation, TLS access or host frameworks.
+// x17=0 means complete; every other status tail-calls the original guest libc.
+// Both copy symbols share one replacement because dyld may resolve aliases to
+// the same implementation address. All valid memcpy calls also satisfy memmove.
+.text
+.p2align 2
+.globl _mcl_platform_copy
+_mcl_platform_copy:
+    cbz x2, Lcopy_done
+    cmp x2, #1, lsl #12
+    b.hs Lcopy_host
+    // Guest libc may choose copy direction before stripping TBI tags. Route
+    // only differing-tag small copies through the normalized native memmove.
+    eor x9, x0, x1
+    lsr x9, x9, #56
+    cbz x9, Lcopy_guest
+Lcopy_host:
+    mov x9, x0
+    mov w16, #0x4d4d
+    mov w17, #1
+    svc #0x80
+    cbnz x17, Lcopy_declined
+Lcopy_done:
+    ret
+Lcopy_declined:
+    mov x0, x9
+Lcopy_guest:
+    b _memmove
+
+.p2align 2
+.globl _mcl_platform_fill
+_mcl_platform_fill:
+    cbz x2, Lfill_done
+    cmp x2, #1, lsl #12
+    b.lo Lfill_guest
+    mov x9, x0
+    mov w16, #0x4d4d
+    mov w17, #2
+    svc #0x80
+    cbnz x17, Lfill_declined
+Lfill_done:
+    ret
+Lfill_declined:
+    mov x0, x9
+Lfill_guest:
+    b _memset
+
+.p2align 2
+.globl _mcl_platform_zero
+_mcl_platform_zero:
+    cbz x1, Lzero_done
+    cmp x1, #1, lsl #12
+    b.lo Lzero_guest
+    mov x9, x0
+    mov w16, #0x4d4d
+    mov w17, #3
+    svc #0x80
+    cbnz x17, Lzero_declined
+Lzero_done:
+    ret
+Lzero_declined:
+    mov x0, x9
+Lzero_guest:
+    b _bzero
