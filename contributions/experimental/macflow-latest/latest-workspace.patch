+fn base_model(status: &Status, page: Page, now_ms: u64) -> PageModel {
+    let subtitle = match page {
+        Page::Overview => "让前台响应、后台工作与资源压力保持平衡。",
+        Page::Applications => "查看运行中的任务，为应用选择明确的管理规则。",
+        Page::Performance => "查看可验证的系统采样与配对测试结果。",
+        Page::Diagnostics => "检查系统能力、异常证据与待完成的验证。",
+        Page::Settings => "管理运行模式、恢复机制与本机安装。",
+    };
+    let mut model = PageModel {
+        page,
+        title: page.title().into(),
+        subtitle: subtitle.into(),
+        metrics: vec![],
+        sections: vec![],
+    };
+    if !sample_fresh(status, now_ms) {
+        model.sections.push(section(
+            "等待新采样",
+            "旧数据仅用于查阅，资源指标及压力状态暂不作为当前结论。",
+            vec![
+                Row::new(
+                    "最近采样",
+                    "用户服务每秒采集一次",
+                    relative_time(status.telemetry.at_ms, now_ms),
+                )
+                .tone(Tone::Warning)
+                .symbol("clock.badge.exclamationmark"),
+            ],
+        ));
+    }
+    if status.diagnostics_truncated {
+        model.sections.push(section(
+            "显示范围",
+            "部分条目因通信容量限制省略，后台仍使用完整进程与规则库存。",
+            vec![
+                Row::new("查看完整证据", "可从诊断页导出本机报告", "部分省略")
+                    .tone(Tone::Muted)
+                    .symbol("doc.text.magnifyingglass"),
+            ],
+        ));
+    }
+    model
+}
+
+/// Converts an authenticated service snapshot into owned display data.
+/// A caller supplies wall-clock milliseconds, keeping this module deterministic.
+pub fn build_page(status: &Status, page: Page, now_ms: u64) -> PageModel {
+    let mut model = base_model(status, page, now_ms);
+    match page {
+        Page::Overview => overview(status, now_ms, &mut model),
+        Page::Applications => applications(status, now_ms, &mut model),
+        Page::Performance => performance(status, now_ms, &mut model),
+        Page::Diagnostics => diagnostics(status, now_ms, &mut model),
+        Page::Settings => settings(status, &mut model),
+    }
+    model
+}
+
+fn overview(status: &Status, now_ms: u64, model: &mut PageModel) {
+    let fresh = sample_fresh(status, now_ms);
+    let cpu = fresh
+        .then_some(status.telemetry.cpu_percent)
+        .flatten()
+        .and_then(|v| finite_nonnegative(Some(v)).filter(|v| *v <= 100.0));
+    let (memory, memory_tone) = memory_state(if fresh {
+        status.telemetry.memory_pressure
+    } else {
+        MemoryPressure::Unknown
+    });
+    model.metrics = vec![
+        Metric {
+            title: "全机 CPU".into(),
+            value: percentage(cpu),
+            subtitle: "所有逻辑核心的总体占用".into(),
+            tone: if cpu.is_some_and(|v| v > 85.0) {
+                Tone::Warning
+            } else if cpu.is_some() {
+                Tone::Neutral
+            } else {
+                Tone::Muted
+            },
+            fraction: cpu.map(|v| v / 100.0),
+        },
+        Metric {
+            title: "内存压力".into(),
+            value: memory.into(),
+            subtitle: "依据系统压力与换页增量".into(),
+            tone: memory_tone,
+            fraction: None,
+        },
+        Metric {
+            title: "下次构建并发".into(),
+            value: status.build_jobs.to_string(),
+            subtitle: "合作构建的新任务启动时生效".into(),
+            tone: Tone::Neutral,
+            fraction: None,
+        },
+        Metric {
+            title: "活动控制".into(),
+            value: status.active_leases.to_string(),
+            subtitle: "带恢复期限的优先级租约".into(),
+            tone: Tone::Neutral,
+            fraction: None,
+        },
+    ];
+    let (state, explanation, tone) = operating_state(status);
+    model.sections.push(section(
+        "当前状态",
+        format!(
+            "{}模式 · MacFlow {}",
+            mode_name(status.config.mode),
+            status.version
+        ),
+        vec![
+            Row::new(
+                state,
+                explanation,
+                if status.config.observe_only {
+                    "仅监测"
+                } else {
+                    "按规则管理"
+                },
+            )
+            .tone(tone)
+            .symbol("waveform.path"),
+            Row::new(
+                "资源争用",
+                "CPU 连续两个 5 秒窗口超过 85%，且存在可管理后台计算任务",
+                if !fresh {
+                    "未知"
+                } else if status.pressure {
+                    "正在保护"
+                } else {
+                    "未检测到"
+                },
+            )
+            .tone(if !fresh {
+                Tone::Muted
+            } else if status.pressure {
+                Tone::Warning
+            } else {
+                Tone::Positive
+            })
+            .symbol("cpu"),
+            Row::new(
+                "可延迟任务",
+                "内存压力时收紧合作任务准入",
+                if status.admit_optional {
+                    "允许新增"
+                } else {
+                    "暂缓新增"
+                },
+            )
+            .tone(if status.admit_optional {
+                Tone::Neutral
+            } else {
+                Tone::Warning
+            })
+            .symbol("hourglass"),
+            Row::new(
+                "管理员助手",
+                "受限优先级调整与租约恢复",
+                if status.helper_connected {
+                    "已连接"
+                } else {
+                    "未连接"
+                },
+            )
+            .tone(if status.helper_connected {
+                Tone::Positive
+            } else {
+                Tone::Warning
+            })
+            .symbol("checkmark.shield"),
+        ],
+    ));
+    let foreground = status.telemetry.foreground_pid.and_then(|pid| {
+        status
+            .telemetry
+            .processes
+            .iter()
+            .find(|p| p.identity.pid == pid)
+    });
+    model.sections.push(section(
+        "前台与运行时",
+        "前台、通话、音视频、输入法与关键系统服务默认保护。",
+        vec![
+            Row::new(
+                if fresh {
+                    "当前前台"
+                } else {
+                    "最近前台应用"
+                },
+                foreground
+                    .map(|p| selector(p))
+                    .unwrap_or_else(|| "前台应用身份尚未出现在当前采样中".into()),
+                foreground
+                    .map(|p| p.name.clone())
+                    .unwrap_or_else(|| "未知".into()),
+            )
+            .tone(if foreground.is_some() && fresh {
+                Tone::Positive
+            } else {
+                Tone::Muted
+            })
+            .symbol("macwindow"),
+            Row::new(
+                "Maclator 连接",
+                "只在策略变化时推送；运行时统计每秒汇总",
