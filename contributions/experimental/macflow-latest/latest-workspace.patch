+    fn graphs(&self, parent: &NSView, width: f64, y: f64, both: bool) -> f64 {
+        let range = if both {
+            self.ivars().history_range.get()
+        } else {
+            0
+        };
+        let live = range == 0;
+        let offset = 0.;
+        let height = if both { 332. } else { 190. };
