+    #[test]
+    fn aggregate_gap_tolerance_is_explicit_and_early_epoch_has_correct_endpoint() {
+        let points = vec![point(30_000, Some(25.0)), point(60_000, Some(50.0))];
+        let mut plotted = vec![];
+        let last = visit_plot_points(&points, 100.0, 120_000, 90_000, 60_000, |sample| {
