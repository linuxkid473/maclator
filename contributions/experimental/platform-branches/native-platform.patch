+    fn cpu(op: u64, dst: u64, second: u64, length: u64) -> Cpu {
+        let mut cpu = Cpu::default();
+        for i in 0..32 { cpu.x[i] = 0x1234_5678_0000_0000 + i as u64; cpu.v[i] = [i as u64, !i as u64]; }
+        cpu.x[0] = dst; cpu.x[1] = second; cpu.x[2] = length; cpu.x[17] = op;
+        cpu.pc = 0x1000; cpu.fpcr = 0x0300_0000; cpu.fpsr = 0x0800_009f;
+        cpu.tpidr_el0 = 0x1122; cpu.tpidrro_el0 = 0x3344; cpu.set_nzcv(0xf);
+        cpu
+    }
+
+    fn unchanged(before: &Cpu, after: &Cpu) {
+        assert_eq!(before.x, after.x); assert_eq!(before.v, after.v);
+        assert_eq!(before.pc, after.pc); assert_eq!(before.nzcv(), after.nzcv());
+        assert_eq!(before.fpcr, after.fpcr); assert_eq!(before.fpsr, after.fpsr);
+        assert_eq!(before.tpidr_el0, after.tpidr_el0); assert_eq!(before.tpidrro_el0, after.tpidrro_el0);
+    }
+
+    #[test]
+    fn complete_range_mapping_and_overflow() {
+        let r = 0x1000_0000;
+        let s = mem::COMMPAGE_SPAN_START;
+        let e = mem::COMMPAGE_SPAN_END;
+        assert_eq!(map_range(0xab00_0000_1234_0000, 4096, false, r), Some(0x1234_0000));
+        assert_eq!(map_range(s | 0xcd00_0000_0000_0000, e - s, false, r), Some(r));
+        assert_eq!(map_range(s + 8, e - s - 8, false, 0), Some(s + 8));
+        assert_eq!(map_range(s - 1, 2, false, r), None);
+        assert_eq!(map_range(e - 1, 2, false, r), None);
+        assert_eq!(map_range(s, 4096, true, r), None);
+        assert_eq!(map_range(s, 4096, true, 0), None);
+        assert_eq!(map_range(0, 1, false, 0), None);
+        assert_eq!(map_range(HOST_END - 1, 2, false, 0), None);
+        assert_eq!(map_range(0xffff_ffff_ffff_fff0, 4096, false, 0), None);
+        assert_eq!(map_range(1, u64::MAX, false, 0), None);
+        assert_eq!(map_range(s, 4096, false, u64::MAX - 100), None);
+    }
+
+    #[test]
+    fn zero_disabled_and_declined_calls_preserve_architecture() {
+        for op in [OP_COPY, OP_FILL, OP_ZERO] {
+            let mut value = cpu(op, u64::MAX, if op == OP_ZERO { 0 } else { u64::MAX }, 0);
+            let before = cpu(op, u64::MAX, if op == OP_ZERO { 0 } else { u64::MAX }, 0);
+            assert!(call(&mut value, true)); unchanged(&before, &value);
+            assert!(!call(&mut value, false)); unchanged(&before, &value);
+        }
+        for (dst, source, length) in [(0, 1, 4096), (1, 0, 4096),
+            (1, 2, u64::MAX), (mem::COMMPAGE_RO, 0x1000, 4096), (1, 2, 4095)] {
+            let mut value = cpu(OP_COPY, dst, source, length);
+            let before = cpu(OP_COPY, dst, source, length);
+            assert!(!call(&mut value, true)); unchanged(&before, &value);
+        }
+    }
+
+    #[test]
+    fn tagged_overlap_copy_fill_and_host_errno() {
+        let mut bytes = vec![0u8; 3 * MIN_SIZE as usize];
+        for (i, byte) in bytes.iter_mut().enumerate() { *byte = (i * 31) as u8; }
+        let initial = bytes.clone();
+        let base = bytes.as_mut_ptr() as u64;
+        let tag = 0xab00_0000_0000_0000;
+        let mut copied = cpu(OP_COPY, (base + 17) | tag, base | 0xcd00_0000_0000_0000, MIN_SIZE);
+        let before = cpu(OP_COPY, (base + 17) | tag, base | 0xcd00_0000_0000_0000, MIN_SIZE);
+        unsafe { *libc::__error() = 73; }
+        assert!(call(&mut copied, true)); unchanged(&before, &copied);
+        assert_eq!(unsafe { *libc::__error() }, 73);
+        assert_eq!(&bytes[17..17 + MIN_SIZE as usize], &initial[..MIN_SIZE as usize]);
+        assert_eq!(&bytes[..17], &initial[..17]);
+        let mut filled = cpu(OP_FILL, base | tag, 0xffff_ffff_ffff_ff39, MIN_SIZE);
+        assert!(call(&mut filled, true));
+        assert!(bytes[..MIN_SIZE as usize].iter().all(|&b| b == 0x39));
+        let mut zeroed = cpu(OP_ZERO, base | tag, MIN_SIZE, u64::MAX);
+        assert!(call(&mut zeroed, true));
+        assert!(bytes[..MIN_SIZE as usize].iter().all(|&b| b == 0));
+        assert_eq!(unsafe { *libc::__error() }, 73);
+    }
+
+    #[test]
+    fn small_mixed_tag_overlap_and_same_tag_decline() {
+        let capacity = 12288;
+        let mut bytes = vec![0u8; capacity];
+        let base = bytes.as_mut_ptr() as u64;
+        let dst_tag = 0xab00_0000_0000_0000;
+        let src_tag = 0xcd00_0000_0000_0000;
+        for length in [1usize, 7, 15, 16, 31, 64, 255, 4095] {
+            for delta in [-63isize, -1, 0, 1, 63] {
+                for (i, byte) in bytes.iter_mut().enumerate() { *byte = (i * 31 + 17) as u8; }
+                let mut expected = bytes.clone();
+                let from = 4096usize;
+                let to = (from as isize + delta) as usize;
+                expected.copy_within(from..from + length, to);
+                let mut value = cpu(OP_COPY, (base + to as u64) | dst_tag,
+                    (base + from as u64) | src_tag, length as u64);
+                let before = cpu(OP_COPY, value.x[0], value.x[1], length as u64);
+                unsafe { *libc::__error() = 73; }
+                assert!(call(&mut value, true)); unchanged(&before, &value);
+                assert_eq!(bytes, expected, "length={length} delta={delta}");
+                assert_eq!(unsafe { *libc::__error() }, 73);
+                value.x[1] = (base + from as u64) | dst_tag;
+                assert!(!call(&mut value, true));
+            }
+        }
