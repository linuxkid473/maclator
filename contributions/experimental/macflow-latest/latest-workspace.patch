+//! Small native AppKit building blocks shared by the five MacFlow pages.
+//!
+//! Colors remain semantic `NSColor` objects, so AppKit resolves them for the
+//! current appearance. Rounded surfaces use `NSBox`; no manually resolved
+//! `CGColor`, custom drawing callback, or layer lifetime is introduced here.
+//! All views are created on the main thread and own their native references.
+
+use objc2::MainThreadOnly;
+use objc2::rc::Retained;
+use objc2_app_kit::*;
+use objc2_foundation::{MainThreadMarker, NSPoint, NSRect, NSSize, NSString};
+
+/// Point sizes form a restrained hierarchy rather than competing headings.
+#[derive(Clone, Copy, Debug)]
+pub enum TextStyle {
+    Title,
+    Subtitle,
+    Section,
+    Body,
+    Secondary,
+    Caption,
+    Metric,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum Tone {
+    Primary,
+    Secondary,
+    Accent,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum ButtonStyle {
+    Standard,
+    Prominent,
+    Quiet,
+    Destructive,
+}
+
+pub struct SidebarRow {
+    pub background: Retained<NSBox>,
+    pub button: Retained<NSButton>,
+}
+
+pub fn rect(x: f64, y: f64, width: f64, height: f64) -> NSRect {
+    NSRect::new(NSPoint::new(x, y), NSSize::new(width, height))
+}
+
+pub fn view(mtm: MainThreadMarker, frame: NSRect) -> Retained<NSView> {
+    NSView::initWithFrame(NSView::alloc(mtm), frame)
+}
+
+pub fn color(tone: Tone) -> Retained<NSColor> {
+    match tone {
+        Tone::Primary => NSColor::labelColor(),
+        Tone::Secondary => NSColor::secondaryLabelColor(),
+        Tone::Accent => NSColor::controlAccentColor(),
+    }
+}
+
+pub fn font(style: TextStyle) -> Retained<NSFont> {
+    // These are immutable AppKit constants, read only while creating UI. No
+    // object reference or raw pointer escapes the generated FFI boundary.
+    let (regular, medium, semibold) = unsafe {
+        (
+            NSFontWeightRegular,
+            NSFontWeightMedium,
+            NSFontWeightSemibold,
+        )
+    };
+    match style {
+        TextStyle::Title => NSFont::systemFontOfSize_weight(28.0, semibold),
+        TextStyle::Subtitle => NSFont::systemFontOfSize_weight(14.0, regular),
+        TextStyle::Section => NSFont::systemFontOfSize_weight(15.0, semibold),
+        TextStyle::Body => NSFont::systemFontOfSize_weight(13.0, regular),
+        TextStyle::Secondary => NSFont::systemFontOfSize_weight(12.0, regular),
+        TextStyle::Caption => NSFont::systemFontOfSize_weight(11.0, medium),
+        TextStyle::Metric => NSFont::monospacedDigitSystemFontOfSize_weight(32.0, semibold),
+    }
+}
+
+pub fn label(
+    mtm: MainThreadMarker,
+    text: &str,
+    style: TextStyle,
+    frame: NSRect,
+) -> Retained<NSTextField> {
+    let field = NSTextField::labelWithString(&NSString::from_str(text), mtm);
+    field.setFrame(frame);
+    field.setFont(Some(&font(style)));
+    field.setTextColor(Some(&color(match style {
+        TextStyle::Subtitle | TextStyle::Secondary | TextStyle::Caption => Tone::Secondary,
+        _ => Tone::Primary,
+    })));
+    field.setBezeled(false);
+    field.setDrawsBackground(false);
+    field.setEditable(false);
+    field.setSelectable(false);
+    field.setUsesSingleLineMode(true);
+    field.setLineBreakMode(NSLineBreakMode::ByTruncatingTail);
+    field
+}
+
+/// A wrapping label for explanatory copy. Give frame-based callers its final
+/// width; Auto Layout callers can constrain it to their card's readable width.
+pub fn paragraph(
+    mtm: MainThreadMarker,
+    text: &str,
+    style: TextStyle,
+    frame: NSRect,
+) -> Retained<NSTextField> {
+    let field = label(mtm, text, style, frame);
+    field.setUsesSingleLineMode(false);
+    field.setMaximumNumberOfLines(0);
+    field.setLineBreakMode(NSLineBreakMode::ByWordWrapping);
+    field
+}
+
+pub fn set_label(field: &NSTextField, text: &str) {
+    let text = NSString::from_str(text);
+    if field.stringValue() != text {
+        field.setStringValue(&text);
+    }
+}
+
+/// Rounded, appearance-aware grouped surface, with a hairline border.
+pub fn card(mtm: MainThreadMarker, frame: NSRect) -> Retained<NSBox> {
+    let box_view = surface(mtm, frame, 14.0);
+    box_view.setFillColor(&NSColor::controlBackgroundColor());
+    box_view.setBorderWidth(0.5);
+    box_view.setBorderColor(&NSColor::separatorColor().colorWithAlphaComponent(0.5));
+    box_view
+}
+
+pub fn surface(mtm: MainThreadMarker, frame: NSRect, radius: f64) -> Retained<NSBox> {
+    let box_view = NSBox::initWithFrame(NSBox::alloc(mtm), frame);
+    box_view.setBoxType(NSBoxType::Custom);
+    box_view.setTitlePosition(NSTitlePosition::NoTitle);
+    box_view.setContentViewMargins(NSSize::new(0.0, 0.0));
+    box_view.setCornerRadius(radius);
+    box_view.setBorderWidth(0.0);
+    box_view.setBorderColor(&NSColor::clearColor());
+    box_view.setFillColor(&NSColor::clearColor());
+    box_view
+}
+
+/// NSBox owns a native content view. Children and anchors should use that
+/// content view, which avoids implicit NSBox margins in frame-based layouts.
+pub fn card_content(card: &NSBox) -> Retained<NSView> {
+    // initWithFrame creates this view; a custom NSBox keeps it even with zero
+    // margins. The fallback preserves a usable parent if AppKit changes that.
+    if let Some(content) = card.contentView() {
+        content
+    } else {
+        let content = view(card.mtm(), card.bounds());
+        card.setContentView(Some(&content));
+        content
+    }
+}
+
+/// Symbols retain their accessibility description and native template tint.
+/// A missing catalog entry simply leaves a text-only control.
+pub fn symbol(name: &str, description: &str, point_size: f64) -> Option<Retained<NSImage>> {
+    let image = NSImage::imageWithSystemSymbolName_accessibilityDescription(
+        &NSString::from_str(name),
+        Some(&NSString::from_str(description)),
+    )?;
+    let configuration = NSImageSymbolConfiguration::configurationWithPointSize_weight(
+        point_size,
+        // Immutable framework constant, as in font().
+        unsafe { NSFontWeightMedium },
+    );
+    let image = image
+        .imageWithSymbolConfiguration(&configuration)
+        .unwrap_or(image);
+    image.setTemplate(true);
+    Some(image)
+}
+
+pub fn icon(
+    mtm: MainThreadMarker,
+    name: &str,
+    description: &str,
+    point_size: f64,
+    tone: Tone,
+) -> Retained<NSImageView> {
+    let image_view = NSImageView::initWithFrame(
+        NSImageView::alloc(mtm),
+        rect(0.0, 0.0, point_size + 4.0, point_size + 4.0),
+    );
+    let image = symbol(name, description, point_size);
+    image_view.setImage(image.as_deref());
+    image_view.setImageScaling(NSImageScaling::ScaleProportionallyDown);
+    image_view.setContentTintColor(Some(&color(tone)));
+    image_view
+}
+
+pub fn icon_tile(
+    mtm: MainThreadMarker,
+    name: &str,
+    description: &str,
+    tone: Tone,
+    frame: NSRect,
+) -> Retained<NSBox> {
+    let tile = surface(mtm, frame, 10.0);
+    tile.setFillColor(&color(tone).colorWithAlphaComponent(0.1));
+    let content = card_content(&tile);
+    let image = icon(mtm, name, description, 18.0, tone);
+    content.addSubview(&image);
+    image.setFrame(rect(
+        (frame.size.width - 22.0) / 2.0,
+        (frame.size.height - 22.0) / 2.0,
+        22.0,
+        22.0,
+    ));
+    image.setAutoresizingMask(
+        NSAutoresizingMaskOptions::ViewMinXMargin
+            | NSAutoresizingMaskOptions::ViewMaxXMargin
+            | NSAutoresizingMaskOptions::ViewMinYMargin
+            | NSAutoresizingMaskOptions::ViewMaxYMargin,
+    );
+    tile
+}
+
+/// Buttons deliberately have no target/action. The page controller owns that
+/// relationship and its caught-panic callback, so helpers introduce no unsafe
+/// selector contract or extra controller lifetime.
+pub fn button(
+    mtm: MainThreadMarker,
+    title: &str,
+    system_symbol: Option<&str>,
+    style: ButtonStyle,
+    frame: NSRect,
+) -> Retained<NSButton> {
+    let button = NSButton::initWithFrame(NSButton::alloc(mtm), frame);
+    button.setTitle(&NSString::from_str(title));
+    button.setButtonType(NSButtonType::MomentaryPushIn);
+    button.setBezelStyle(NSBezelStyle::Push);
+    button.setControlSize(NSControlSize::Regular);
+    button.setFont(Some(&font(TextStyle::Body)));
+    if let Some(name) = system_symbol {
+        let image = symbol(name, title, 13.0);
+        button.setImage(image.as_deref());
+        button.setImagePosition(NSCellImagePosition::ImageLeading);
+        button.setImageHugsTitle(true);
+    }
+    match style {
+        ButtonStyle::Standard => {}
+        ButtonStyle::Prominent => {
+            button.setBezelColor(Some(&NSColor::controlAccentColor()));
+        }
+        ButtonStyle::Quiet => {
+            button.setBordered(false);
+            button.setContentTintColor(Some(&NSColor::secondaryLabelColor()));
+        }
+        ButtonStyle::Destructive => {
+            button.setContentTintColor(Some(&NSColor::systemRedColor()));
+        }
+    }
+    button
+}
+
+pub fn sidebar_row(
+    mtm: MainThreadMarker,
+    title: &str,
+    system_symbol: &str,
+    tag: isize,
+    frame: NSRect,
+) -> SidebarRow {
+    let background = surface(mtm, frame, 9.0);
+    let content = card_content(&background);
+    let button = button(
+        mtm,
+        title,
+        Some(system_symbol),
+        ButtonStyle::Quiet,
+        rect(10.0, 1.0, frame.size.width - 20.0, frame.size.height - 2.0),
+    );
+    button.setTag(tag);
+    button.setAlignment(NSTextAlignment::Left);
+    button.setButtonType(NSButtonType::MomentaryChange);
+    button.setFont(Some(&font(TextStyle::Body)));
+    button.setContentTintColor(Some(&NSColor::labelColor()));
+    button.setAutoresizingMask(NSAutoresizingMaskOptions::ViewWidthSizable);
+    content.addSubview(&button);
+    SidebarRow { background, button }
+}
+
+pub fn set_sidebar_selected(row: &SidebarRow, selected: bool) {
+    if selected {
+        row.background
+            .setFillColor(&NSColor::controlAccentColor().colorWithAlphaComponent(0.14));
+        row.button
+            .setContentTintColor(Some(&NSColor::controlAccentColor()));
+        row.button.setState(NSControlStateValueOn);
+    } else {
+        row.background.setFillColor(&NSColor::clearColor());
+        row.button.setContentTintColor(Some(&NSColor::labelColor()));
+        row.button.setState(NSControlStateValueOff);
+    }
+}
+
+pub fn separator(mtm: MainThreadMarker, frame: NSRect) -> Retained<NSBox> {
+    let separator = NSBox::initWithFrame(NSBox::alloc(mtm), frame);
+    separator.setBoxType(NSBoxType::Separator);
+    separator
+}
