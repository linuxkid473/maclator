+
+fn start_compatibility_worker(
+    state: Shared,
+    saved: Option<serde_json::Value>,
+) -> Result<CompatibilityWorker, String> {
+    use std::sync::mpsc;
+    let (notify_tx, notifications) = mpsc::sync_channel(1);
+    let (requests, request_rx) = mpsc::sync_channel::<CompatibilityPersistence>(1);
+    let updates = Arc::new(Mutex::new(CompatibilityUpdates::default()));
+    let worker_updates = updates.clone();
+    std::thread::Builder::new()
+        .name("macflow-compatibility".into())
+        .spawn(move || {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                let mut previous = saved.map(Ok);
+                let mut revision = 0u64;
+                let mut next_check = 0;
+                let mut cache = RuntimeFingerprintCache::default();
+                loop {
+                    let now = macflow_platform::now_ms();
+                    if now >= next_check {
+                        let signature = compatibility_signature(&mut cache);
+                        if previous.as_ref() != Some(&signature) {
+                            revision = revision.saturating_add(1);
+                        }
+                        previous = Some(signature.clone());
+                        publish_compatibility(
+                            &worker_updates,
+                            &notify_tx,
+                            Some(CompatibilityProbe {
+                                revision,
+                                at_ms: macflow_platform::now_ms(),
+                                signature,
+                            }),
+                            None,
+                        );
+                        next_check = now.saturating_add(COMPATIBILITY_INTERVAL_MS);
+                    }
+                    let wait = next_check.saturating_sub(macflow_platform::now_ms());
+                    match request_rx.recv_timeout(Duration::from_millis(wait)) {
+                        Ok(request) => {
+                            let result = persist_compatibility(&state, &request);
+                            publish_compatibility(
+                                &worker_updates,
+                                &notify_tx,
+                                None,
+                                Some((request.generation, result)),
+                            );
+                        }
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    }
+                }
+            }));
+            if result.is_err() {
+                // Panic never crosses system callbacks. The controller's gate and
+                // independent helper leases remain fail-open if this worker exits.
+                publish_compatibility(
+                    &worker_updates,
+                    &notify_tx,
+                    Some(CompatibilityProbe {
+                        revision: u64::MAX,
+                        at_ms: macflow_platform::now_ms(),
+                        signature: Err("compatibility worker panicked".into()),
+                    }),
+                    None,
+                );
+            }
+        })
+        .map_err(|e| e.to_string())?;
+    Ok(CompatibilityWorker {
+        notifications,
+        updates,
+        requests,
+    })
+}
+
+fn poll_compatibility(
+    state: &Shared,
+    worker: &CompatibilityWorker,
+    monitor: &mut CompatibilityMonitor,
+    now_ms: u64,
+) {
+    use std::sync::{
+        TryLockError,
+        mpsc::{TryRecvError, TrySendError},
+    };
+    let mut messages = Vec::new();
+    match worker.notifications.try_recv() {
+        Ok(()) => {
+            let latest = std::mem::take(
+                &mut *worker
+                    .updates
+                    .lock()
+                    .unwrap_or_else(|_| std::process::exit(70)),
+            );
+            if let Some(probe) = latest.probe {
+                if let Some(message) = monitor.accept_probe(probe) {
+                    messages.push(message);
+                }
+            }
+            if let Some((generation, result)) = latest.persisted {
+                if let Some(message) = monitor.accept_persistence(generation, result, now_ms) {
+                    messages.push(message);
+                }
+            }
+        }
+        Err(TryRecvError::Disconnected) => {
+            if let Some(message) = monitor.unavailable("worker disconnected") {
+                messages.push(message);
+            }
+        }
+        Err(TryRecvError::Empty) => {}
+    }
+    if let Some(message) = monitor.check_freshness(now_ms) {
+        messages.push(message);
+    }
+    {
+        let mut s = state.lock().unwrap_or_else(|_| std::process::exit(70));
+        // Independent gate is immediate even if an XPC mutation is waiting on
+        // disk. Effective CPU/runtime policies cannot continue behind that lock.
+        s.compatibility_gate = monitor.required;
+        s.compatibility_generation = monitor.generation;
+        for message in messages {
+            s.event("compatibility", message);
+        }
+    }
+    if monitor.required && !monitor.committed && monitor.pending.is_some() {
+        match CONFIGURATION_MUTATION.try_lock() {
+            Ok(_mutation) => {
+                let mut s = state.lock().unwrap_or_else(|_| std::process::exit(70));
+                s.status.config.observe_only = true;
+                monitor.committed = true;
+            }
+            Err(TryLockError::WouldBlock) => return,
+            Err(TryLockError::Poisoned(_)) => std::process::exit(70),
+        }
+    }
+    if monitor.committed && now_ms >= monitor.retry_after_ms {
+        if let Some(request) = monitor.pending.take() {
+            match worker.requests.try_send(request.clone()) {
+                Ok(()) => monitor.in_flight = Some(request),
+                Err(TrySendError::Full(request)) | Err(TrySendError::Disconnected(request)) => {
+                    // Keep the latest fingerprint pending; never silently lose
+                    // restoration/persistence work on a saturated bounded queue.
+                    monitor.pending = Some(request);
+                }
+            }
+        }
+    }
+}
