+//! Bounded local history loading for a background UI worker.
+//!
+//! The reader does not generate samples, interpolate missing time ranges, or
+//! infer performance improvements. The returned timestamps belong to actual
+//! records. `truncated` means either the read/display budget limited precision
+//! or some otherwise relevant file could not fit the seven-file budget.
+#![forbid(unsafe_code)]
+
+use macflow_protocol::MemoryPressure;
+use std::{
+    fs::{self, OpenOptions},
+    io::{Read, Seek, SeekFrom},
+    os::unix::fs::OpenOptionsExt,
+    path::{Path, PathBuf},
+};
+
+pub const MAX_READ_BYTES: u64 = 8 * 1024 * 1024;
+pub const MAX_POINTS: usize = 3000;
+const MAX_FILES: usize = 7;
+const MAX_LINE_BYTES: usize = 64 * 1024;
+const MAX_DIRECTORY_ENTRIES: usize = 4096;
+const SEVEN_DAYS: u64 = 7 * 86400;
+/// On-disk aggregate records normally arrive every 30 seconds. A long gap
+/// must remain a break even when intervening points are reduced for display.
+const GAP_SECONDS: u64 = 90;
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct HistoryPoint {
+    pub epoch_seconds: u64,
+    pub cpu: Option<f64>,
+    pub compressed_gib: Option<f64>,
+    pub memory_pressure: MemoryPressure,
+}
+
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct History {
+    pub points: Vec<HistoryPoint>,
+    /// A short explanation of an I/O or record-format problem. Partial usable
+    /// observations are retained when one file cannot be read.
+    pub error: Option<String>,
+    pub bytes_read: u64,
+    pub truncated: bool,
+}
+
+#[derive(Clone, Copy)]
+struct Limits {
+    read_bytes: u64,
+    files: usize,
+    points: usize,
+    line_bytes: usize,
+    entries: usize,
+}
+
+const LIMITS: Limits = Limits {
+    read_bytes: MAX_READ_BYTES,
+    files: MAX_FILES,
+    points: MAX_POINTS,
+    line_bytes: MAX_LINE_BYTES,
+    entries: MAX_DIRECTORY_ENTRIES,
+};
+
+/// Reads at most eight MiB from the newest seven eligible `day-*.jsonl` files.
+/// Call on the UI's finite background worker, never on AppKit's main thread.
+/// Missing history is an empty result; malformed/missing values are never zero.
+pub fn load(dir: &Path, now_epoch: u64) -> History {
+    load_with_limits(dir, now_epoch, LIMITS)
+}
+
+fn note(history: &mut History, text: impl AsRef<str>) {
+    // Keep error text bounded even when all eligible files fail. Avoid absolute
+    // user paths in the visible summary; the UI can offer an explicit export.
+    let text = text.as_ref();
+    let text = text.chars().take(220).collect::<String>();
+    match &mut history.error {
+        None => history.error = Some(text),
+        Some(existing) if !existing.contains(&text) && existing.chars().count() < 600 => {
+            existing.push_str("；");
+            existing.push_str(&text);
+        }
+        _ => {}
+    }
+}
+
+fn day_number(path: &Path) -> Option<u64> {
+    let name = path.file_name()?.to_str()?;
+    let digits = name.strip_prefix("day-")?.strip_suffix(".jsonl")?;
+    if digits.is_empty() || !digits.bytes().all(|v| v.is_ascii_digit()) {
+        return None;
+    }
+    digits.parse().ok()
+}
+
+fn eligible_paths(
+    dir: &Path,
+    now_epoch: u64,
+    limits: Limits,
+    history: &mut History,
+) -> Vec<PathBuf> {
+    let metadata = match fs::symlink_metadata(dir) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return vec![],
+        Err(error) => {
+            note(history, format!("历史目录无法读取：{error}"));
+            return vec![];
+        }
+    };
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        note(history, "历史目录不是常规目录，已拒绝读取链接或特殊文件");
+        return vec![];
+    }
+    let entries = match fs::read_dir(dir) {
+        Ok(entries) => entries,
+        Err(error) => {
+            note(history, format!("历史目录无法列出：{error}"));
+            return vec![];
+        }
+    };
+    let earliest_day = now_epoch.saturating_sub(SEVEN_DAYS) / 86400;
+    let latest_day = now_epoch / 86400;
+    let mut paths = Vec::<(u64, PathBuf)>::with_capacity(limits.files + 1);
+    for (index, entry) in entries.enumerate() {
+        if index >= limits.entries {
+            history.truncated = true;
+            note(history, "历史目录条目过多，已限制本次扫描范围");
+            break;
+        }
+        let entry = match entry {
+            Ok(entry) => entry,
+            Err(error) => {
+                note(history, format!("部分历史目录条目无法读取：{error}"));
+                continue;
+            }
+        };
+        let path = entry.path();
+        let Some(day) = day_number(&path) else {
+            continue;
+        };
+        if !(earliest_day..=latest_day).contains(&day) {
+            continue;
+        }
+        paths.push((day, path));
+        paths.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| b.1.cmp(&a.1)));
+        if paths.len() > limits.files {
+            history.truncated = true;
+            paths.truncate(limits.files);
+        }
+    }
+    // Process chronological file order so duplicate timestamps retain the last
+    // appended record, including the newer file when duplicate dates exist.
+    paths.sort();
+    paths.into_iter().map(|(_, path)| path).collect()
+}
+
+fn load_with_limits(dir: &Path, now_epoch: u64, limits: Limits) -> History {
+    let mut history = History::default();
+    let paths = eligible_paths(dir, now_epoch, limits, &mut history);
+    let mut points = Vec::new();
+    for (index, path) in paths.iter().enumerate() {
+        let remaining = limits.read_bytes.saturating_sub(history.bytes_read);
+        if remaining == 0 {
+            history.truncated = true;
+            break;
+        }
+        // Share the remaining allowance among unread daily files. Small files
+        // return their unused allowance to later files. A large first file
+        // therefore cannot exhaust the entire seven-day display budget.
+        let allowance = remaining / (paths.len() - index) as u64;
+        if allowance == 0 {
+            history.truncated = true;
+            continue;
+        }
+        let mut file = match OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(path)
+        {
+            Ok(file) => file,
+            Err(error) => {
+                note(&mut history, format!("部分历史文件无法安全打开：{error}"));
+                continue;
+            }
+        };
+        let metadata = match file.metadata() {
+            Ok(metadata) if metadata.is_file() => metadata,
+            Ok(_) => {
+                note(&mut history, "已跳过非常规历史文件");
+                continue;
+            }
+            Err(error) => {
+                note(&mut history, format!("部分历史文件无法核验：{error}"));
+                continue;
+            }
+        };
+        let read_length = metadata.len().min(allowance);
+        let start = metadata.len().saturating_sub(read_length);
+        if start > 0 {
+            history.truncated = true;
+        }
+        if let Err(error) = file.seek(SeekFrom::Start(start)) {
+            note(&mut history, format!("部分历史文件无法定位：{error}"));
+            continue;
+        }
+        let mut data = Vec::with_capacity(read_length as usize);
+        let read_result = file.take(read_length).read_to_end(&mut data);
+        history.bytes_read += data.len() as u64;
+        if let Err(error) = read_result {
+            note(&mut history, format!("部分历史文件读取失败：{error}"));
+        }
+        parse_tail(
+            &data,
+            start > 0,
+            now_epoch,
+            limits,
+            &mut points,
+            &mut history,
+        );
+    }
+    points.sort_by_key(|point| point.epoch_seconds);
+    // Stable sort + reverse means the latest appended duplicate wins. This
+    // avoids presenting multiple different values at the same chart position.
+    points.reverse();
+    points.dedup_by_key(|point| point.epoch_seconds);
+    points.reverse();
+    if points.len() > limits.points {
+        history.truncated = true;
+        points = reduce_points(&points, limits.points);
+    }
+    history.points = points;
+    history
+}
+
+fn parse_tail(
+    data: &[u8],
+    partial_start: bool,
+    now_epoch: u64,
+    limits: Limits,
+    points: &mut Vec<HistoryPoint>,
+    history: &mut History,
+) {
+    let mut start = 0;
+    let mut first = true;
+    for (index, byte) in data.iter().enumerate() {
+        if *byte != b'\n' {
+            continue;
+        }
+        let line = &data[start..index];
+        start = index + 1;
+        if first && partial_start {
+            first = false;
+            continue;
+        }
+        first = false;
+        if line.is_empty() || line.iter().all(u8::is_ascii_whitespace) {
+            continue;
+        }
+        if line.len() > limits.line_bytes {
+            history.truncated = true;
+            note(history, "部分历史记录超过单行容量限制，已跳过");
+            continue;
+        }
+        match parse_point(line, now_epoch) {
+            Ok(Some(point)) => points.push(point),
+            Ok(None) => {}
+            Err(ParseError::LegacyMissingTimestamp) => {
+                note(history, "已跳过缺少历史时间戳的旧格式记录")
+            }
+            Err(ParseError::Invalid) => note(history, "部分历史记录格式无效，已跳过"),
+        }
+    }
+    // The writer appends newline-terminated records. A concurrent incomplete
+    // final append is intentionally excluded instead of parsing half a record.
+    if start < data.len() {
+        if data.len() - start > limits.line_bytes {
+            history.truncated = true;
+            note(history, "末尾历史记录超过单行容量限制，已跳过");
+        } else {
+            note(history, "末尾未完成的历史记录已暂时跳过");
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum ParseError {
+    LegacyMissingTimestamp,
+    Invalid,
+}
+
+fn parse_point(line: &[u8], now_epoch: u64) -> Result<Option<HistoryPoint>, ParseError> {
+    let value: serde_json::Value = serde_json::from_slice(line).map_err(|_| ParseError::Invalid)?;
+    // Early history stored Status directly, with a monotonic telemetry clock
+    // but no absolute recorded time. Recognize that documented shape without
+    // pretending its at_ms value is an epoch or reconstructing sample dates.
+    if value.get("recorded_epoch_seconds").is_none()
+        && value
+            .get("version")
+            .is_some_and(|version| version.is_string())
+        && value.get("telemetry").is_some_and(|telemetry| {
+            telemetry.is_object()
+                && telemetry
+                    .get("at_ms")
+                    .and_then(|time| time.as_u64())
+                    .is_some()
+        })
+    {
+        return Err(ParseError::LegacyMissingTimestamp);
+    }
+    let epoch_seconds = value["recorded_epoch_seconds"]
+        .as_u64()
+        .ok_or(ParseError::Invalid)?;
+    if epoch_seconds == 0 || epoch_seconds > now_epoch || now_epoch - epoch_seconds > SEVEN_DAYS {
+        return Ok(None);
+    }
+    let telemetry = value
+        .get("telemetry")
+        .filter(|value| value.is_object())
+        .ok_or(ParseError::Invalid)?;
+    let cpu = telemetry["cpu_percent"]
+        .as_f64()
+        .filter(|value| value.is_finite() && (0.0..=100.0).contains(value));
+    let compressed_gib = telemetry["compressed_bytes"]
+        .as_u64()
+        .map(|value| value as f64 / 1_073_741_824.0);
+    let memory_pressure = match telemetry["memory_pressure"].as_str() {
+        Some("normal") => MemoryPressure::Normal,
+        Some("warning") => MemoryPressure::Warning,
+        Some("critical") => MemoryPressure::Critical,
+        _ => MemoryPressure::Unknown,
+    };
+    Ok(Some(HistoryPoint {
+        epoch_seconds,
+        cpu,
+        compressed_gib,
+        memory_pressure,
+    }))
+}
+
+fn reduce_points(points: &[HistoryPoint], limit: usize) -> Vec<HistoryPoint> {
+    if limit == 0 {
+        return vec![];
+    }
+    if limit == 1 {
+        return points.last().cloned().into_iter().collect();
+    }
+    let mut result = Vec::with_capacity(limit);
+    let mut previous = 0;
+    for slot in 0..limit {
+        let index = slot * (points.len() - 1) / (limit - 1);
+        let mut selected = points[index].clone();
+        if slot > 0 {
+            let skipped = &points[previous + 1..=index];
+            let gap = points[previous..=index]
+                .windows(2)
+                .any(|pair| pair[1].epoch_seconds - pair[0].epoch_seconds > GAP_SECONDS);
+            // Never bridge an omitted unknown sample or an actual time gap.
+            // Retained known values are real readings. Clearing a selected
+            // reading is conservative display omission, never fabricated data.
+            if gap || skipped.iter().any(|point| point.cpu.is_none()) {
+                selected.cpu = None;
+            }
+            if gap || skipped.iter().any(|point| point.compressed_gib.is_none()) {
+                selected.compressed_gib = None;
+            }
+            if gap
+                || skipped
+                    .iter()
+                    .any(|point| point.memory_pressure == MemoryPressure::Unknown)
+            {
+                selected.memory_pressure = MemoryPressure::Unknown;
+            }
+        }
+        result.push(selected);
+        previous = index;
+    }
+    result
+}
